---
import "@fontsource-variable/roboto";

import "../styles/variables.styl";
import "../styles/palettes.css";
import "../styles/main.css";
import "../styles/transition.css";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";
import "../styles/expressive-code.css";
import "../styles/photoswipe.css";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import MusicPlayer from "@components/MusicPlayer.svelte";
import PortfolioGate from "@components/PortfolioGate.svelte";
import ReadingProgress from "@components/ReadingProgress.svelte";
import Analytics from "@vercel/analytics/astro";
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { url } from "../utils/url-utils";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	hidePlayer?: boolean;
	ogImage?: string;
}

let {
	title,
	description,
	lang,
	setOGTypeArticle,
	hidePlayer = false,
	ogImage,
} = Astro.props;

// Define the theme variable in the root layout so Astro can apply it globally.
const configHue = siteConfig.themeColor.hue;
const isHomePage = Astro.url.pathname === "/";
const defaultDescription =
	"A personal collection of writing, photographs, and notes by Nguyễn Thanh Tùng.";

let pageTitle: string;
if (isHomePage) {
	pageTitle = siteConfig.title;
} else if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.title;
}

const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const metaDescription = isHomePage
	? defaultDescription
	: description || defaultDescription;
const defaultOgImage = new URL("/api/og", siteOrigin);
defaultOgImage.searchParams.set(
	"title",
	isHomePage ? "Nguyễn Thanh Tùng" : pageTitle,
);
defaultOgImage.searchParams.set("subtitle", metaDescription);
defaultOgImage.searchParams.set(
	"category",
	isHomePage
		? "Personal journal"
		: setOGTypeArticle
			? "Post"
			: siteConfig.title,
);
const ogImageUrl = ogImage
	? new URL(ogImage, siteOrigin).toString()
	: defaultOgImage.toString();

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
const enableAnalytics = import.meta.env.PROD && process.env.VERCEL === "1";
const enableCustomAnalytics = import.meta.env.PROD;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");
const ogLocale = siteLang.replace("-", "_");
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px] antialiased"
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription}>
		<meta name="author" content={profileConfig.name}>
		<meta name="theme-color" content="#edf7f7" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#061514" media="(prefers-color-scheme: dark)">
		<link rel="canonical" href={canonicalUrl}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:locale" content={ogLocale}>
		<meta property="og:url" content={canonicalUrl}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={metaDescription}>
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:alt" content={pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={canonicalUrl}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={metaDescription}>
		<meta name="twitter:image" content={ogImageUrl}>
		<meta name="twitter:image:alt" content={pageTitle}>

		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, PAGE_WIDTH, configHue}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);
			const storedPalette = localStorage.getItem('palette');
			const palettes = ['ocean', 'sakura', 'forest', 'mono'];
			if (palettes.includes(storedPalette)) {
				document.documentElement.dataset.palette = storedPalette;
			} else if (!localStorage.getItem('hue')) {
				document.documentElement.dataset.palette = 'ocean';
			}

			const readerFontScales = { compact: '0.94', normal: '1', large: '1.1' };
			const readerWidths = {
				narrow: ['40rem', '44rem'],
				normal: ['46rem', '50rem'],
				wide: ['54rem', '58rem'],
			};
			const storedReaderFont = localStorage.getItem('blog-reader-font');
			const storedReaderWidth = localStorage.getItem('blog-reader-width');
			const readerScale = readerFontScales[storedReaderFont] || readerFontScales.normal;
			const readerWidth = readerWidths[storedReaderWidth] || readerWidths.normal;
			document.documentElement.style.setProperty('--reader-font-scale', readerScale);
			document.documentElement.style.setProperty('--reader-content-width', readerWidth[0]);
			document.documentElement.style.setProperty('--reader-shell-width', readerWidth[1]);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class="min-h-screen transition">
		<a class="skip-link" href="#swup-container">Skip to main content</a>
		<ConfigCarrier></ConfigCarrier>
		<template id="photoswipe-home-icon">
			<Icon name="fa6-solid:house" aria-hidden="true" />
		</template>
		{setOGTypeArticle && <ReadingProgress client:idle />}
		<slot />
		<PortfolioGate client:load />
		{!hidePlayer && <MusicPlayer client:idle />}
		{enableAnalytics && <Analytics />}
		{enableCustomAnalytics && <script is:inline src="/scripts/analytics-tracker.js" defer></script>}
		<script is:inline>
			(() => {
				const registerWebMcpTools = () => {
					const modelContext = navigator.modelContext;
					if (!modelContext || typeof modelContext.registerTool !== "function") return;

					if (window.__thanhTungWebMcpController) {
						window.__thanhTungWebMcpController.abort();
					}
					const controller = new AbortController();
					window.__thanhTungWebMcpController = controller;

					const textResult = (value) => ({
						content: [
							{
								type: "text",
								text:
									typeof value === "string"
										? value
										: JSON.stringify(value, null, 2),
							},
						],
					});

					const tools = [
						{
							name: "search_blog",
							description:
								"Search Thanh Tung Blog posts by title, tag, category, description, or body text.",
							inputSchema: {
								type: "object",
								properties: {
									query: {
										type: "string",
										description: "Search query.",
									},
									limit: {
										type: "number",
										description: "Maximum number of results.",
										default: 5,
									},
								},
								required: ["query"],
							},
							execute: async (input) => {
								const query = String(input?.query ?? "")
									.trim()
									.toLowerCase();
								const limit = Math.min(Math.max(Number(input?.limit ?? 5), 1), 10);
								if (!query) return textResult([]);
								const index = await fetch("/search-index.json").then((response) =>
									response.json(),
								);
								const results = index.posts
									.map((post) => {
										const haystack = [
											post.title,
											post.description,
											post.category,
											...(post.tags ?? []),
											post.content,
										]
											.join(" ")
											.toLowerCase();
										const titleMatch = post.title.toLowerCase().includes(query) ? 3 : 0;
										const tagMatch = (post.tags ?? []).some((tag) =>
											String(tag).toLowerCase().includes(query),
										)
											? 2
											: 0;
										const bodyMatch = haystack.includes(query) ? 1 : 0;
										return { post, score: titleMatch + tagMatch + bodyMatch };
									})
									.filter((item) => item.score > 0)
									.sort((a, b) => b.score - a.score)
									.slice(0, limit)
									.map(({ post }) => ({
										title: post.title,
										url: new URL(post.url, location.origin).toString(),
										description: post.description,
										category: post.category,
										tags: post.tags,
									}));
								return textResult(results);
							},
						},
						{
							name: "get_current_page_markdown",
							description:
								"Return the current Thanh Tung Blog page as Markdown when available.",
							inputSchema: {
								type: "object",
								properties: {},
							},
							execute: async () => {
								const markdown = await fetch(location.pathname, {
									headers: { Accept: "text/markdown" },
								}).then((response) => response.text());
								return textResult(markdown);
							},
						},
						{
							name: "open_blog_path",
							description: "Navigate to a path on Thanh Tung Blog.",
							inputSchema: {
								type: "object",
								properties: {
									path: {
										type: "string",
										description: "Site path, for example /archive/ or /posts/example/.",
									},
								},
								required: ["path"],
							},
							execute: async (input) => {
								const rawPath = String(input?.path ?? "/")
									.trim()
									.replace(/^https?:\/\/[^/]+/i, "");
								const path = rawPath.startsWith("/") ? rawPath : `/${rawPath}`;
								location.assign(path);
								return textResult(`Opening ${path}`);
							},
						},
					];

					for (const tool of tools) {
						try {
							modelContext.registerTool(tool, { signal: controller.signal });
						} catch {
							try {
								modelContext.registerTool(tool.name, tool, tool.execute, {
									signal: controller.signal,
								});
							} catch {}
						}
					}
				};

				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", registerWebMcpTools, {
						once: true,
					});
				} else {
					registerWebMcpTools();
				}
			})();
		</script>
		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<script>
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		if (!panelDom) return;
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom!.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

function initScrollableKatex() {
	const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>;
	katexElements.forEach(element => {
		if (!element.parentNode) return;
		if (element.parentElement?.classList.contains('katex-display-container')) return;

		const container = document.createElement('div');
		container.className = 'katex-display-container';
		container.setAttribute('role', 'region');
		container.setAttribute('tabindex', '0');
		container.setAttribute('aria-label', 'Horizontally scrollable formula');

		element.parentNode.insertBefore(container, element);
		container.appendChild(element);
	});
}

function init() {
	loadTheme();
	loadHue();
	initScrollableKatex();
}

/* Load settings when entering the site */
init();

const setup = () => {
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')
	})
	window.swup.hooks.on('content:replace', initScrollableKatex)
	window.swup.hooks.on('visit:start', () => {
		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});
	window.swup.hooks.on('page:view', () => {
		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		setTimeout(() => {
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.add('hidden')
			}

            // Just make the transition looks better
            const toc = document.getElementById('toc-wrapper');
            if (toc) {
                toc.classList.remove('toc-not-ready')
            }
        }, 200)
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

let backToTopBtn = document.getElementById('back-to-top-btn');
function scrollFunction() {
	if (backToTopBtn) {
		if (window.scrollY > 480) {
			backToTopBtn.classList.remove('hide')
		} else {
			backToTopBtn.classList.add('hide')
		}
	}
}
window.addEventListener('scroll', scrollFunction, { passive: true })
scrollFunction()

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"

const lightboxes: PhotoSwipeLightbox[] = []
const photoSwipeGalleries = [
	{ gallery: ".gallery-groups", children: ".photo-gallery .gallery-image-link" },
	{ gallery: ".custom-md", children: "img" },
	{ gallery: "#post-cover", children: "img" },
]

function createPhotoSwipe(gallery: string, children: string) {
	if (!document.querySelector(gallery)) return

	const lightbox = new PhotoSwipeLightbox({
		gallery,
		children,
		pswpModule: () => import("photoswipe"),
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: true,
		arrowNext: true,
		arrowPrevTitle: "Previous image",
		arrowNextTitle: "Next image",
		closeTitle: "Close",
		zoomTitle: "Zoom",
		arrowKeys: true,
		escKey: true,
		allowPanToNext: true,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		} else if (element instanceof HTMLAnchorElement) {
			const preview = element.querySelector("img")
			itemData.src = element.href
			itemData.w = Number(element.dataset.pswpWidth || preview?.naturalWidth || window.innerWidth)
			itemData.h = Number(element.dataset.pswpHeight || preview?.naturalHeight || window.innerHeight)
			itemData.msrc = preview?.src
		} else if (element instanceof HTMLElement && element.dataset.pswpSrc) {
			const preview = element.querySelector("img")
			itemData.src = element.dataset.pswpSrc
			itemData.w = Number(element.dataset.pswpWidth || preview?.naturalWidth || window.innerWidth)
			itemData.h = Number(element.dataset.pswpHeight || preview?.naturalHeight || window.innerHeight)
			itemData.msrc = preview?.src
		}

		return itemData
	})

	lightbox.on("afterInit", () => {
		const pswp = lightbox?.pswp
		if (!pswp?.element) return

		const topBar = pswp.element.querySelector(".pswp__top-bar")
		if (topBar) {
			const homeLink = document.createElement("a")
			homeLink.className = "pswp__button pswp__button--home"
			homeLink.href = "/"
			homeLink.title = "Back to home"
			homeLink.setAttribute("aria-label", "Back to home")

			const iconTemplate = document.querySelector<HTMLTemplateElement>("#photoswipe-home-icon")
			if (iconTemplate) homeLink.append(iconTemplate.content.cloneNode(true))

			const homeLabel = document.createElement("span")
			homeLabel.textContent = "Home"
			homeLink.append(homeLabel)
			homeLink.addEventListener("click", () => pswp.close())

			const firstButton = topBar.querySelector(".pswp__button")
			topBar.insertBefore(homeLink, firstButton)
		}

		const captionElement = document.createElement("div")
		captionElement.className = "pswp__gallery-caption"
		captionElement.setAttribute("aria-live", "polite")
		pswp.element.append(captionElement)

		const updateCaption = () => {
			const source = pswp.currSlide?.data.element
			const title = source instanceof HTMLImageElement
				? source.alt
				: source instanceof HTMLElement
					? source.dataset.pswpTitle || source.querySelector("img")?.alt || ""
					: ""
			const description = source instanceof HTMLElement
				? source.dataset.pswpDescription || ""
				: ""

			captionElement.replaceChildren()
			captionElement.hidden = !title && !description
			if (title) {
				const titleElement = document.createElement("strong")
				titleElement.textContent = title
				captionElement.append(titleElement)
			}
			if (description) {
				const descriptionElement = document.createElement("span")
				descriptionElement.textContent = description
				captionElement.append(descriptionElement)
			}
		}

		pswp.on("change", updateCaption)
		updateCaption()
	})

	lightbox.init()
	lightboxes.push(lightbox)
}

function createPhotoSwipeGalleries() {
	for (const config of photoSwipeGalleries) {
		createPhotoSwipe(config.gallery, config.children)
	}
}

function destroyPhotoSwipeGalleries() {
	for (const lightbox of lightboxes) lightbox.destroy()
	lightboxes.length = 0
}

const setupSwupPhotoSwipe = () => {
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipeGalleries()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			destroyPhotoSwipeGalleries()
		},
		{ before: true },
	)
}

createPhotoSwipeGalleries()

if (window.swup?.hooks) {
	setupSwupPhotoSwipe()
} else {
	document.addEventListener("swup:enable", setupSwupPhotoSwipe, { once: true })
}
</script>
