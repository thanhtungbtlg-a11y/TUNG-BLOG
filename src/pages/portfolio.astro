---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout
	title="Hồ sơ"
	description="Hồ sơ nghề nghiệp của Nguyễn Thanh Tùng"
>
	<section class="profile-panel card-base onload-animation">
		<div class="profile-grid" aria-hidden="true"></div>
		<div class="profile-glow" aria-hidden="true"></div>

		<div class="profile-content">
			<div class="profile-kicker">
				<Icon name="material-symbols:person-outline-rounded" />
				Hồ sơ cá nhân
			</div>
			<h1>Nguyễn Thanh Tùng</h1>
			<p>
				Một trang hồ sơ được đặt ngay trong blog cá nhân, ghi lại định hướng,
				công việc và những dự án có thể chia sẻ theo thời gian.
			</p>

			<div class="profile-actions">
				<a href="mailto:thanhtungbtlg@gmail.com">
					<Icon name="fa6-regular:envelope" />
					Email
				</a>
			</div>
		</div>
	</section>

	<section class="profile-sections onload-animation">
		<article class="profile-card card-base">
			<Icon name="material-symbols:engineering-outline-rounded" />
			<div>
				<h2>Định hướng</h2>
				<p>
					Quan tâm đến thiết kế kỹ thuật, hệ thống MEP, và cách công nghệ giúp
					công việc kỹ thuật trở nên rõ ràng, chính xác hơn.
				</p>
			</div>
		</article>

		<article class="profile-card card-base">
			<Icon name="material-symbols:folder-outline-rounded" />
			<div>
				<h2>Dự án</h2>
				<p>
					Khu vực này sẽ được dùng để gom lại các dự án, ghi chú học tập, và
					những sản phẩm có thể công khai theo thời gian.
				</p>
			</div>
		</article>

		<article class="profile-card card-base">
			<Icon name="material-symbols:handshake-outline-rounded" />
			<div>
				<h2>Kết nối</h2>
				<p>
					Có thể liên hệ qua email nếu cần trao đổi công việc hoặc có nội dung
					cụ thể hơn.
				</p>
			</div>
		</article>
	</section>
</MainGridLayout>

<style>
	.profile-panel {
		position: relative;
		overflow: hidden;
		border: 1px solid oklch(0.82 0.08 var(--hue) / 0.28);
		background:
			radial-gradient(
				circle at 82% 18%,
				oklch(0.68 0.16 var(--hue) / 0.22),
				transparent 24rem
			),
			linear-gradient(
				135deg,
				oklch(0.18 0.035 var(--hue)),
				oklch(0.11 0.024 calc(var(--hue) + 70))
			);
		box-shadow: 0 24px 80px oklch(0 0 0 / 0.25);
	}

	.profile-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(oklch(1 0 0 / 0.055) 1px, transparent 1px),
			linear-gradient(90deg, oklch(1 0 0 / 0.055) 1px, transparent 1px);
		background-size: 2.6rem 2.6rem;
		mask-image: radial-gradient(circle at 50% 50%, black, transparent 76%);
	}

	.profile-glow {
		position: absolute;
		right: -6rem;
		top: -8rem;
		width: 24rem;
		height: 24rem;
		border-radius: 999px;
		background: oklch(0.72 0.18 calc(var(--hue) + 45) / 0.2);
		filter: blur(48px);
		animation: glow-drift 7s ease-in-out infinite alternate;
	}

	.profile-content {
		position: relative;
		z-index: 1;
		max-width: 42rem;
		padding: clamp(2rem, 5vw, 4.5rem);
		color: white;
	}

	.profile-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		border: 1px solid oklch(1 0 0 / 0.16);
		background: oklch(1 0 0 / 0.08);
		color: oklch(0.88 0.06 var(--hue));
		font-size: 0.85rem;
		font-weight: 750;
		letter-spacing: 0;
		text-transform: uppercase;
		backdrop-filter: blur(16px);
	}

	.profile-kicker :global(svg) {
		font-size: 1.05rem;
	}

	.profile-content h1 {
		margin: 0;
		max-width: 34rem;
		font-size: clamp(2.75rem, 7vw, 5.6rem);
		line-height: 0.96;
		letter-spacing: 0;
		text-wrap: balance;
		background: linear-gradient(90deg, white, oklch(0.8 0.12 var(--hue)));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: 0 18px 64px oklch(0 0 0 / 0.32);
	}

	.profile-content p {
		margin: 1.35rem 0 0;
		max-width: 35rem;
		color: oklch(0.9 0.025 var(--hue) / 0.84);
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.profile-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.profile-actions a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		border: 1px solid oklch(1 0 0 / 0.16);
		border-radius: 999px;
		background: oklch(1 0 0 / 0.09);
		color: white;
		padding: 0 1rem;
		font-weight: 800;
		text-decoration: none;
		backdrop-filter: blur(14px);
		transition:
			transform 160ms ease,
			background 160ms ease,
			border-color 160ms ease;
	}

	.profile-actions a:hover,
	.profile-actions a:focus-visible {
		border-color: oklch(1 0 0 / 0.3);
		background: oklch(1 0 0 / 0.14);
		outline: none;
		transform: translateY(-1px);
	}

	.profile-sections {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	.profile-card {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr);
		gap: 0.9rem;
		padding: 1.1rem;
	}

	.profile-card :global(svg) {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.9rem;
		background: var(--btn-regular-bg);
		color: var(--primary);
		padding: 0.62rem;
	}

	.profile-card h2 {
		margin: 0 0 0.35rem;
		color: rgb(0 0 0 / 0.86);
		font-size: 1rem;
		font-weight: 850;
	}

	:global(.dark) .profile-card h2 {
		color: rgb(255 255 255 / 0.9);
	}

	.profile-card p {
		margin: 0;
		color: rgb(0 0 0 / 0.58);
		font-size: 0.92rem;
		line-height: 1.65;
	}

	:global(.dark) .profile-card p {
		color: rgb(255 255 255 / 0.62);
	}

	@keyframes glow-drift {
		to {
			transform: translate(-2rem, 2rem) scale(1.08);
		}
	}

	@media (max-width: 1024px) {
		.profile-sections {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.profile-content {
			padding: 2rem;
		}

		.profile-actions {
			display: grid;
			grid-template-columns: 1fr;
		}

		.profile-actions a {
			justify-content: center;
		}
	}
</style>
