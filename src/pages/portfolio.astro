---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout
	title="CV/Portfolio"
	description="COMING SOON - Nguyen Thanh Tung portfolio"
>
	<section class="portfolio-panel card-base onload-animation">
		<div class="portfolio-grid" aria-hidden="true"></div>
		<div class="portfolio-glow" aria-hidden="true"></div>
		<div class="portfolio-orbit" aria-hidden="true">
			<span></span>
			<span></span>
			<span></span>
		</div>

		<div class="portfolio-content">
			<div class="portfolio-kicker">
				<Icon name="material-symbols:article-outline-rounded" />
				CV / Portfolio
			</div>
			<h1>COMING SOON</h1>
			<p>
				Nguyễn Thanh Tùng đang chuẩn bị một góc riêng để gom lại hành trình,
				dự án, và những điều đáng kể.
			</p>
			<div class="portfolio-tags" aria-label="Portfolio preview sections">
				<span>Profile</span>
				<span>Projects</span>
				<span>Experience</span>
				<span>Contact</span>
			</div>
		</div>
	</section>
</MainGridLayout>

<style>
	.portfolio-panel {
		position: relative;
		min-height: 32rem;
		overflow: hidden;
		border: 1px solid oklch(0.82 0.08 var(--hue) / 0.28);
		background:
			radial-gradient(
				circle at 20% 20%,
				oklch(0.68 0.16 var(--hue) / 0.18),
				transparent 28rem
			),
			linear-gradient(
				135deg,
				oklch(0.18 0.035 var(--hue)),
				oklch(0.12 0.022 calc(var(--hue) + 60))
			);
		box-shadow: 0 24px 80px oklch(0 0 0 / 0.25);
	}

	.portfolio-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(oklch(1 0 0 / 0.055) 1px, transparent 1px),
			linear-gradient(90deg, oklch(1 0 0 / 0.055) 1px, transparent 1px);
		background-size: 2.6rem 2.6rem;
		mask-image: radial-gradient(circle at 50% 50%, black, transparent 74%);
	}

	.portfolio-glow {
		position: absolute;
		right: -9rem;
		top: -9rem;
		width: 28rem;
		height: 28rem;
		border-radius: 999px;
		background: oklch(0.72 0.18 calc(var(--hue) + 45) / 0.18);
		filter: blur(48px);
		animation: glow-drift 7s ease-in-out infinite alternate;
	}

	.portfolio-orbit {
		position: absolute;
		right: 8%;
		top: 50%;
		width: min(42vw, 22rem);
		aspect-ratio: 1;
		transform: translateY(-50%);
		border-radius: 999px;
		border: 1px solid oklch(1 0 0 / 0.16);
		animation: orbit-spin 18s linear infinite;
	}

	.portfolio-orbit span {
		position: absolute;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 999px;
		background: oklch(0.82 0.14 var(--hue));
		box-shadow: 0 0 1.5rem oklch(0.82 0.14 var(--hue) / 0.7);
	}

	.portfolio-orbit span:nth-child(1) {
		left: 12%;
		top: 18%;
	}

	.portfolio-orbit span:nth-child(2) {
		right: 8%;
		top: 45%;
	}

	.portfolio-orbit span:nth-child(3) {
		bottom: 12%;
		left: 36%;
	}

	.portfolio-content {
		position: relative;
		z-index: 1;
		max-width: 36rem;
		padding: clamp(2rem, 5vw, 4.5rem);
		color: white;
	}

	.portfolio-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		border: 1px solid oklch(1 0 0 / 0.16);
		background: oklch(1 0 0 / 0.08);
		color: oklch(0.88 0.06 var(--hue));
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
		backdrop-filter: blur(16px);
	}

	.portfolio-kicker :global(svg) {
		font-size: 1.1rem;
	}

	.portfolio-content h1 {
		margin: 0;
		font-size: clamp(3rem, 9vw, 6.5rem);
		line-height: 0.92;
		letter-spacing: 0;
		text-wrap: balance;
		background: linear-gradient(90deg, white, oklch(0.78 0.12 var(--hue)));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: 0 18px 64px oklch(0 0 0 / 0.32);
	}

	.portfolio-content p {
		margin: 1.4rem 0 0;
		max-width: 31rem;
		color: oklch(0.88 0.025 var(--hue) / 0.82);
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.portfolio-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 2rem;
	}

	.portfolio-tags span {
		border: 1px solid oklch(1 0 0 / 0.16);
		border-radius: 999px;
		background: oklch(1 0 0 / 0.075);
		padding: 0.55rem 0.85rem;
		color: oklch(0.94 0.02 var(--hue));
		font-size: 0.9rem;
		font-weight: 650;
		backdrop-filter: blur(14px);
	}

	@keyframes orbit-spin {
		to {
			transform: translateY(-50%) rotate(360deg);
		}
	}

	@keyframes glow-drift {
		to {
			transform: translate(-2rem, 2rem) scale(1.08);
		}
	}

	@media (max-width: 768px) {
		.portfolio-panel {
			min-height: 28rem;
		}

		.portfolio-orbit {
			right: -6rem;
			opacity: 0.45;
		}

		.portfolio-content {
			padding: 2rem;
		}
	}
</style>
