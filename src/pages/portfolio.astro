---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import {
	credentials,
	portfolioHighlights,
	portfolioProfile,
	portfolioProjects,
	skillGroups,
	workExperience,
} from "@/data/portfolio";
---

<MainGridLayout
	title="Portfolio"
	description={`The professional portfolio of ${portfolioProfile.name}`}
	wide={true}
>
	<Fragment slot="head">
		<meta name="robots" content="noindex, nofollow, noarchive" />
	</Fragment>
	<div class="portfolio-shell">
		<header class="portfolio-hero onload-animation">
			<div class="hero-copy">
				<p class="eyebrow">
					<Icon name="material-symbols:person-outline-rounded" />
					{portfolioProfile.kicker}
				</p>
				<h1>{portfolioProfile.name}</h1>
				<p class="headline">{portfolioProfile.headline}</p>
				<p class="summary">{portfolioProfile.summary}</p>
				<p class="profile-location">
					<Icon name="material-symbols:location-on-outline-rounded" />
					{portfolioProfile.location}
				</p>
				<div class="contact-actions">
					<a
						class="contact-link"
						href={portfolioProfile.email}
						target="_blank"
						rel="noopener noreferrer"
					>
						<Icon name="fa6-regular:envelope" />
						Email
					</a>
					<a
						class="contact-link secondary"
						href={portfolioProfile.linkedin}
						target="_blank"
						rel="noopener noreferrer"
					>
						<Icon name="fa6-brands:linkedin-in" />
						LinkedIn
					</a>
				</div>
			</div>

			<dl class="career-snapshot" aria-label="Career snapshot">
				{
					portfolioHighlights.map((item) => (
						<div>
							<dt>{item.label}</dt>
							<dd>{item.value}</dd>
						</div>
					))
				}
			</dl>
		</header>

		<nav class="section-nav onload-animation" aria-label="Portfolio sections">
			<a href="#experience">Experience</a>
			<a href="#projects">Projects</a>
			<a href="#skills">Skills</a>
			<a href="#credentials">Credentials</a>
		</nav>

		<section id="experience" class="portfolio-section onload-animation">
			<div class="section-heading">
				<div>
					<p class="section-index">01 · Work history</p>
					<h2>Professional experience</h2>
				</div>
				<p>
					Each company record connects a role with responsibilities,
					contributions, tools, and related project work.
				</p>
			</div>

			{
				workExperience.length > 0 ? (
					<div class="experience-list">
						{workExperience.map((entry, index) => (
							<details class="experience-folder card-base" open={index === 0}>
								<summary>
									<span class="folder-icon">
										<Icon name="material-symbols:folder-open-outline-rounded" />
									</span>
									<span class="company-copy">
										<strong>{entry.company}</strong>
										<span>{entry.role}</span>
									</span>
									<span class="company-meta">
										<span>{entry.period}</span>
										{entry.location && <small>{entry.location}</small>}
									</span>
									<Icon
										class="folder-chevron"
										name="material-symbols:keyboard-arrow-down-rounded"
									/>
								</summary>

								<div class="experience-body">
									<p class="experience-summary">{entry.summary}</p>
									<div class="experience-columns">
										<div>
											<h3>Responsibilities</h3>
											<ul>
												{entry.responsibilities.map((item) => <li>{item}</li>)}
											</ul>
										</div>
										{entry.achievements && entry.achievements.length > 0 && (
											<div>
												<h3>Contributions</h3>
												<ul>
													{entry.achievements.map((item) => <li>{item}</li>)}
												</ul>
											</div>
										)}
									</div>
									{entry.relatedProjects &&
										entry.relatedProjects.length > 0 && (
											<div class="related-projects">
												<strong>Related projects</strong>
												{entry.relatedProjects.map((item) => <span>{item}</span>)}
											</div>
										)}
									{entry.tools && entry.tools.length > 0 && (
										<ul class="tag-list" aria-label="Tools and methods">
											{entry.tools.map((item) => <li>{item}</li>)}
										</ul>
									)}
								</div>
							</details>
						))}
					</div>
				) : (
					<div class="empty-state">
						<Icon name="material-symbols:work-history-outline-rounded" />
						<div>
							<h3>Company history is ready to be added</h3>
							<p>
								The layout is prepared for company, role, period,
								responsibilities, contributions, tools, and linked projects.
							</p>
						</div>
					</div>
				)
			}
		</section>

		<section id="projects" class="portfolio-section onload-animation">
			<div class="section-heading">
				<div>
					<p class="section-index">02 · Selected work</p>
					<h2>Project case studies</h2>
				</div>
				<p>
					Selected work is documented through context, personal role, process,
					and deliverables.
				</p>
			</div>

			<div class="project-grid">
				{
					portfolioProjects.map((project) => (
						<article class="project-card card-base interactive-card">
							{project.image && (
								<div class="project-visual">
									<img
										src={project.image}
										alt={project.imageAlt ?? ""}
										width={project.imageWidth}
										height={project.imageHeight}
										loading="lazy"
										decoding="async"
									/>
								</div>
							)}
							<div class="project-topline">
								<span>{project.category}</span>
								<span class:list={["status", project.status.toLowerCase()]}>
									{project.status}
								</span>
							</div>
							<h3>{project.title}</h3>
							<p class="project-period">{project.period}</p>
							<p class="project-summary">{project.summary}</p>

							<div class="project-detail">
								<strong>My role</strong>
								<p>{project.role}</p>
							</div>

							<div class="project-detail">
								<strong>Process</strong>
								<ol>
									{project.process.map((step) => <li>{step}</li>)}
								</ol>
							</div>

							<div class="project-detail">
								<strong>Deliverables</strong>
								<p>{project.deliverables}</p>
							</div>

							<ul class="tag-list" aria-label={`${project.title} skills`}>
								{project.skills.map((item) => <li>{item}</li>)}
							</ul>

							{project.href && (
								<a class="project-link" href={project.href}>
									View project
									<Icon name="material-symbols:arrow-outward-rounded" />
								</a>
							)}
						</article>
					))
				}
			</div>
		</section>

		<section id="skills" class="portfolio-section onload-animation">
			<div class="section-heading">
				<div>
					<p class="section-index">03 · Capabilities</p>
					<h2>Skills and working knowledge</h2>
				</div>
				<p>
					Capabilities are grouped by working context rather than subjective
					percentage scores.
				</p>
			</div>

			<div class="skill-grid">
				{
					skillGroups.map((group) => (
						<article class="skill-card card-base">
							<Icon name={group.icon} />
							<h3>{group.title}</h3>
							<p>{group.description}</p>
							<ul>
								{group.items.map((item) => <li>{item}</li>)}
							</ul>
						</article>
					))
				}
			</div>
		</section>

		<section id="credentials" class="portfolio-section onload-animation">
			<div class="section-heading">
				<div>
					<p class="section-index">04 · Background</p>
					<h2>Education and credentials</h2>
				</div>
				<p>
					Formal education, professional certificates, and relevant training
					can be maintained here.
				</p>
			</div>

			{
				credentials.length > 0 ? (
					<div class="credential-list">
						{credentials.map((credential) => (
							<article class="credential-row">
								<div>
									<h3>{credential.title}</h3>
									<p>{credential.issuer}</p>
									{credential.detail && <small>{credential.detail}</small>}
								</div>
								<div class="credential-meta">
									<span>{credential.period}</span>
									{credential.href && (
										<a href={credential.href} target="_blank" rel="noopener noreferrer">
											Verify
											<Icon name="material-symbols:arrow-outward-rounded" />
										</a>
									)}
								</div>
							</article>
						))}
					</div>
				) : (
					<div class="empty-state compact">
						<Icon name="material-symbols:workspace-premium-outline-rounded" />
						<div>
							<h3>Credentials will appear here</h3>
							<p>
								This section is ready for education, certifications, and
								professional training.
							</p>
						</div>
					</div>
				)
			}
		</section>
	</div>
</MainGridLayout>

<style>
	.portfolio-shell {
		display: grid;
		gap: clamp(2.5rem, 6vw, 5rem);
		padding-bottom: 2rem;
	}

	.portfolio-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: end;
		padding: clamp(2rem, 6vw, 5rem);
		border: 1px solid oklch(0.82 0.08 var(--hue) / 0.28);
		border-radius: var(--public-radius-surface);
		background:
			linear-gradient(oklch(1 0 0 / 0.035) 1px, transparent 1px),
			linear-gradient(90deg, oklch(1 0 0 / 0.035) 1px, transparent 1px),
			linear-gradient(
				135deg,
				oklch(0.18 0.035 var(--hue)),
				oklch(0.11 0.024 calc(var(--hue) + 70))
			);
		background-size:
			2.75rem 2.75rem,
			2.75rem 2.75rem,
			100% 100%;
		color: white;
		box-shadow: 0 24px 80px oklch(0 0 0 / 0.22);
	}

	.eyebrow,
	.section-index {
		margin: 0;
		color: oklch(0.82 0.1 var(--hue));
		font-family: var(--public-font-mono);
		font-size: var(--public-font-meta);
		font-weight: 850;
		text-transform: uppercase;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.eyebrow :global(svg) {
		font-size: 1.1rem;
	}

	.hero-copy h1 {
		margin: 1rem 0 0;
		font-size: clamp(2.7rem, 5vw, 4rem);
		line-height: 1;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.headline {
		max-width: 46rem;
		margin: 1.5rem 0 0;
		color: oklch(0.92 0.035 var(--hue));
		font-size: clamp(1.15rem, 2vw, 1.5rem);
		font-weight: 700;
		line-height: 1.45;
		text-wrap: balance;
	}

	.summary {
		max-width: 40rem;
		margin: 0.9rem 0 0;
		color: oklch(0.86 0.02 var(--hue) / 0.76);
		line-height: 1.75;
	}

	.profile-location {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 1rem 0 0;
		color: oklch(0.88 0.02 var(--hue) / 0.72);
		font-size: 0.9rem;
	}

	.profile-location :global(svg) {
		font-size: 1.15rem;
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1.5rem;
	}

	.contact-link {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: var(--control-height);
		padding: 0 1.1rem;
		border: 1px solid oklch(1 0 0 / 0.18);
		border-radius: var(--public-radius-control);
		background: oklch(1 0 0 / 0.08);
		color: white;
		font-weight: 800;
		text-decoration: none;
		transition:
			transform 180ms ease,
			background 180ms ease;
	}

	.contact-link:hover {
		background: oklch(1 0 0 / 0.14);
		transform: translateY(-1px);
	}

	.contact-link.secondary {
		background: transparent;
	}

	.career-snapshot {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin: 0;
		border: 1px solid oklch(1 0 0 / 0.12);
		border-radius: var(--public-radius-surface);
		background: oklch(0.08 0.015 var(--hue) / 0.52);
		backdrop-filter: blur(12px);
	}

	.career-snapshot div {
		min-height: 6.5rem;
		padding: 1rem;
		border-right: 1px solid oklch(1 0 0 / 0.1);
		border-bottom: 1px solid oklch(1 0 0 / 0.1);
	}

	.career-snapshot div:nth-child(2n) {
		border-right: 0;
	}

	.career-snapshot div:nth-last-child(-n + 2) {
		border-bottom: 0;
	}

	.career-snapshot dt {
		color: oklch(0.78 0.02 var(--hue) / 0.7);
		font-family: var(--public-font-mono);
		font-size: var(--public-font-meta);
		font-weight: 750;
		text-transform: uppercase;
	}

	.career-snapshot dd {
		margin: 0.45rem 0 0;
		color: white;
		font-size: 1rem;
		font-weight: 800;
		line-height: 1.35;
	}

	.section-nav {
		position: sticky;
		top: 4.75rem;
		z-index: 20;
		display: flex;
		gap: 0.4rem;
		width: fit-content;
		max-width: 100%;
		margin: calc(clamp(2.5rem, 6vw, 5rem) * -0.65) auto 0;
		padding: 0.4rem;
		overflow-x: auto;
		border: 1px solid var(--card-border);
		border-radius: var(--public-radius-surface);
		background: var(--float-panel-bg);
		box-shadow: var(--card-shadow);
		backdrop-filter: blur(14px);
	}

	.section-nav a {
		flex: none;
		padding: 0.55rem 0.9rem;
		border-radius: var(--public-radius-control);
		color: var(--meta-color);
		font-size: 0.84rem;
		font-weight: 800;
		text-decoration: none;
	}

	.section-nav a:hover,
	.section-nav a:focus-visible {
		background: var(--btn-regular-bg);
		color: var(--primary);
	}

	.portfolio-section {
		scroll-margin-top: 9rem;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
		gap: 2rem;
		align-items: end;
		margin-bottom: 1.5rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--line-divider);
	}

	.section-heading h2 {
		margin: 0.35rem 0 0;
		color: var(--content-color);
		font-family: var(--public-font-serif);
		font-size: var(--public-font-section);
		font-weight: 620;
		line-height: 1.1;
		letter-spacing: 0;
	}

	.section-heading > p {
		margin: 0;
		color: var(--meta-color);
		line-height: 1.7;
	}

	.experience-list {
		display: grid;
		gap: 0.8rem;
	}

	.experience-folder {
		overflow: clip;
	}

	.experience-folder summary {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr) auto 1.5rem;
		gap: 1rem;
		align-items: center;
		padding: 1.15rem;
		cursor: pointer;
		list-style: none;
	}

	.experience-folder summary::-webkit-details-marker {
		display: none;
	}

	.folder-icon {
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		border-radius: 0.5rem;
		background: var(--btn-regular-bg);
		color: var(--primary);
		font-size: 1.45rem;
	}

	.company-copy {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	.company-copy strong {
		color: var(--content-color);
		font-size: 1.05rem;
	}

	.company-copy span,
	.company-meta {
		color: var(--meta-color);
	}

	.company-meta {
		display: grid;
		justify-items: end;
		font-size: var(--public-font-small);
	}

	.folder-chevron {
		color: var(--meta-color);
		font-size: 1.35rem;
		transition: transform 180ms ease;
	}

	.experience-folder[open] .folder-chevron {
		transform: rotate(180deg);
	}

	.experience-body {
		padding: 0 1.15rem 1.4rem 5.15rem;
		border-top: 1px solid var(--line-divider);
	}

	.experience-summary {
		margin: 1.2rem 0;
		color: var(--meta-color);
	}

	.experience-columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.experience-columns h3,
	.project-detail strong,
	.related-projects strong {
		color: var(--content-color);
		font-size: 0.82rem;
		text-transform: uppercase;
	}

	.experience-columns ul,
	.project-detail ol {
		margin: 0.65rem 0 0;
		padding-left: 1.15rem;
		color: var(--meta-color);
	}

	.experience-columns li,
	.project-detail li {
		margin-top: 0.4rem;
	}

	.related-projects {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
		margin-top: 1.25rem;
	}

	.related-projects span,
	.tag-list li {
		padding: 0.32rem 0.55rem;
		border-radius: 0.4rem;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		font-size: var(--public-font-meta);
		font-weight: 700;
	}

	.empty-state {
		display: flex;
		gap: 1rem;
		align-items: center;
		min-height: 10rem;
		padding: 1.5rem;
		border: 1px dashed color-mix(in oklch, var(--primary), var(--card-border) 58%);
		border-radius: var(--radius-large);
		background: color-mix(in oklch, var(--card-bg), transparent 24%);
	}

	.empty-state.compact {
		min-height: 8rem;
	}

	.empty-state > :global(svg) {
		flex: none;
		width: 3rem;
		height: 3rem;
		padding: 0.65rem;
		border-radius: 0.5rem;
		background: var(--btn-regular-bg);
		color: var(--primary);
	}

	.empty-state h3,
	.empty-state p {
		margin: 0;
	}

	.empty-state h3 {
		color: var(--content-color);
		font-size: 1.05rem;
	}

	.empty-state p {
		margin-top: 0.35rem;
		color: var(--meta-color);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.project-card {
		--project-card-padding: clamp(1.25rem, 3vw, 2rem);

		display: flex;
		flex-direction: column;
		padding: var(--project-card-padding);
		overflow: hidden;
	}

	.project-visual {
		position: relative;
		aspect-ratio: 16 / 9;
		margin: calc(0px - var(--project-card-padding))
			calc(0px - var(--project-card-padding)) 1.35rem;
		overflow: hidden;
		background: var(--btn-regular-bg);
	}

	.project-visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 320ms ease;
	}

	.project-card:hover .project-visual img {
		transform: scale(1.025);
	}

	.project-topline {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--meta-color);
		font-family: var(--public-font-mono);
		font-size: var(--public-font-meta);
		font-weight: 750;
		text-transform: uppercase;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--primary);
	}

	.status::before {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: currentColor;
		content: "";
	}

	.project-card h3 {
		margin: 1.2rem 0 0;
		color: var(--content-color);
		font-size: 1.6rem;
		letter-spacing: 0;
	}

	.project-period {
		margin: 0.2rem 0 0;
		color: var(--meta-color);
		font-family: var(--public-font-mono);
		font-size: var(--public-font-meta);
	}

	.project-summary {
		margin: 1rem 0 0;
		color: var(--meta-color);
		line-height: 1.7;
	}

	.project-detail {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line-divider);
	}

	.project-detail p {
		margin: 0.45rem 0 0;
		color: var(--meta-color);
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		width: fit-content;
		margin-top: 1.5rem;
		color: var(--primary);
		font-weight: 800;
		text-decoration: none;
	}

	.project-link :global(svg) {
		transition: transform 180ms ease;
	}

	.project-link:hover :global(svg) {
		transform: translate(2px, -2px);
	}

	.skill-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.skill-card {
		padding: 1.25rem;
	}

	.skill-card > :global(svg) {
		width: 2.75rem;
		height: 2.75rem;
