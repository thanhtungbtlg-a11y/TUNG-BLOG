---
import { getEntry, render } from "astro:content";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import Markdown from "@components/misc/Markdown.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---

<MainGridLayout
	title={i18n(I18nKey.about)}
	description="About Nguyễn Thanh Tùng and this personal collection of writing, photographs, and notes."
	wide
	immediateContent
>
	<section class="about-shell">
		<div class="about-profile">
			<a
				href="#about-content"
				class="about-avatar"
				aria-label="Skip to the introduction"
			>
				<ImageWrapper
					src={profileConfig.avatar || ""}
					alt={`Portrait of ${profileConfig.name}`}
					class="h-full w-full"
				></ImageWrapper>
			</a>
			<div class="about-intro">
				<p class="about-kicker">About</p>
				<h1>{profileConfig.name}</h1>
				{profileConfig.bio && <blockquote>{profileConfig.bio}</blockquote>}
				<div class="about-links" aria-label="Personal links">
					{
						profileConfig.links.map((item) => (
							<a
								rel="me noopener noreferrer"
								aria-label={item.name}
								href={item.url}
								target={item.url.startsWith("mailto:") ? undefined : "_blank"}
								data-no-swup={item.url.startsWith("mailto:") ? true : undefined}
								class="about-link"
							>
								<Icon name={item.icon} />
								<span>{item.name}</span>
							</a>
						))
					}
				</div>
			</div>
		</div>

		<div id="about-content" class="about-content">
			<Markdown class="mt-0">
				<Content />
			</Markdown>
		</div>
	</section>
</MainGridLayout>

<style>
	.about-shell {
		padding: clamp(1rem, 3vw, 2rem) 0.25rem;
	}

	.about-profile {
		display: grid;
		grid-template-columns: minmax(11rem, 15rem) minmax(0, 1fr);
		gap: clamp(1.25rem, 3vw, 2rem);
		align-items: stretch;
		padding-bottom: clamp(1.25rem, 3vw, 2rem);
		border-bottom: 1px solid var(--line-divider);
	}

	.about-avatar {
		position: relative;
		display: block;
		overflow: hidden;
		min-height: 15rem;
		border-radius: var(--public-radius-surface);
		border: 1px solid color-mix(in oklch, var(--primary), transparent 62%);
		background: var(--btn-regular-bg);
	}

	.about-intro {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
	}

	.about-kicker {
		margin: 0 0 0.55rem;
		color: var(--btn-content);
		font-family: var(--public-font-mono);
		font-size: var(--public-font-meta);
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.about-intro h1 {
		margin: 0;
		color: var(--content-color);
		font-family: var(--public-font-serif);
		font-size: var(--public-font-title);
		font-weight: 620;
		line-height: 1.08;
		text-wrap: balance;
	}

	.about-intro blockquote {
		max-width: 36rem;
		margin: 1rem 0 0;
		padding-left: 1rem;
		border-left: 3px solid var(--primary);
		color: var(--content-color);
		font-family: var(--public-font-sans);
		font-size: clamp(var(--public-font-body), 2vw, 1.125rem);
		font-style: italic;
		font-weight: 650;
		line-height: 1.65;
		opacity: 0.78;
	}

	.about-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1.4rem;
	}

	.about-link {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.5rem;
		padding: 0 0.9rem;
		border: 1px solid var(--line-divider);
		border-radius: var(--public-radius-control);
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		font-family: var(--public-font-sans);
		font-size: var(--public-font-small);
		font-weight: 800;
		transition:
			transform 180ms ease,
			background-color 180ms ease,
			color 180ms ease;
	}

	.about-link:hover {
		transform: translateY(-2px);
		background: var(--btn-regular-bg-hover);
		color: var(--primary);
	}

	.about-link :global(svg) {
		font-size: 1.25rem;
	}

	.about-content {
		max-width: var(--public-content-measure);
		padding-top: clamp(1.2rem, 3vw, 2rem);
		font-family: var(--public-font-sans);
		font-size: var(--public-font-body);
	}

	.about-content :global(.custom-md) {
		margin-top: 0;
	}

	@media (max-width: 760px) {
		.about-profile {
			grid-template-columns: 1fr;
		}

		.about-avatar {
			min-height: 14rem;
			max-height: 19rem;
		}

		.about-link {
			flex: 1 1 calc(50% - 0.65rem);
			justify-content: center;
		}
	}

	@media (max-width: 460px) {
		.about-link {
			flex-basis: 100%;
		}
	}
</style>
