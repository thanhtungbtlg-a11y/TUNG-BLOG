---
import path from "node:path";
import AnonymousComments from "@components/AnonymousComments.svelte";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getRelatedPosts, getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import PostReactions from "../../components/PostReactions.svelte";
import PostShare from "../../components/PostShare.svelte";
import PostTools from "../../components/PostTools.svelte";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const { remarkPluginFrontmatter } = await entry.render();
const relatedPosts = await getRelatedPosts(entry, 3);
const shareUrl = new URL(
	getPostUrlBySlug(entry.slug),
	Astro.site ?? Astro.url.origin,
).toString();
const ogImageUrl = new URL("/api/og", Astro.site ?? Astro.url.origin);
ogImageUrl.searchParams.set("title", entry.data.title);
if (entry.data.description) {
	ogImageUrl.searchParams.set("subtitle", entry.data.description);
}
if (entry.data.category) {
	ogImageUrl.searchParams.set("category", entry.data.category);
}
ogImageUrl.searchParams.set("date", formatDateToYYYYMMDD(entry.data.published));

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	url: shareUrl,
	mainEntityOfPage: shareUrl,
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	...(entry.data.updated && {
		dateModified: formatDateToYYYYMMDD(entry.data.updated),
	}),
	publisher: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	image: ogImageUrl.toString(),
};
---
<MainGridLayout title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings} ogImage={ogImageUrl.toString()} immediateContent={true}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-[var(--meta-color)] gap-5 mb-3 transition">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="relative">
				<h1
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.data.title}
				</h1>
            </div>

            <!-- metadata -->
            <div>
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <PostTools
                slug={entry.slug}
                title={entry.data.title}
                url={shareUrl}
                published={formatDateToYYYYMMDD(entry.data.published)}
                client:idle
            />

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} alt={`Cover image: ${entry.data.title}`} basePath={path.join("content/posts/", getDir(entry.id))} widths={[640, 960, 1280]} sizes="(max-width: 1024px) calc(100vw - 2rem), 768px" class="mb-8 rounded-lg cover-zoom"/>
            }

            <div class="mb-7 flex items-center gap-3 text-xs font-bold uppercase tracking-normal text-[var(--meta-color)]">
                <div class="h-px flex-1 border-t border-dashed border-[var(--line-divider)]"></div>
                <div class="inline-flex items-center gap-2 rounded-full bg-black/5 px-3 py-1.5 dark:bg-white/10">
                    <Icon name="material-symbols:menu-book-outline-rounded" class="text-base text-[var(--primary)]" />
                    Article
                </div>
                <div class="h-px flex-1 border-t border-dashed border-[var(--line-divider)]"></div>
            </div>


            <Markdown class="mb-6 markdown-content">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="mb-6 rounded-lg license-container onload-animation"></License>}

        </div>
    </div>

    <PostShare title={entry.data.title} shareUrl={shareUrl} client:visible />
    <PostReactions slug={entry.slug} client:visible />
    <AnonymousComments slug={entry.slug} client:visible />
    <RelatedPosts posts={relatedPosts} />

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
		{entry.data.nextSlug && <a href={getPostUrlBySlug(entry.data.nextSlug)} aria-label={`Next post: ${entry.data.nextTitle}`} class="w-full font-bold overflow-hidden active:scale-95">
			<div class="btn-card rounded-lg w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
			</div>
		</a>}

		{entry.data.prevSlug && <a href={getPostUrlBySlug(entry.data.prevSlug)} aria-label={`Previous post: ${entry.data.prevTitle}`} class="w-full font-bold overflow-hidden active:scale-95">
			<div class="btn-card rounded-lg w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
			</div>
		</a>}
    </div>

</MainGridLayout>
