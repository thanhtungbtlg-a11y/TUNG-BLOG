---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getChronologicalPostsList } from "../utils/content-utils";

const sortedPostsList = await getChronologicalPostsList();
---

<MainGridLayout
	title={i18n(I18nKey.archive)}
	description="The complete writing archive of Nguyễn Thanh Tùng"
	wide
>
	<ArchivePanel sortedPosts={sortedPostsList} client:load></ArchivePanel>
</MainGridLayout>
