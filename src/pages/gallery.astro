---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import galleryMetadata from "../data/gallery.json";

type GalleryMetadata = {
	filename: string;
	thumbnail?: string;
	title?: string;
	description?: string;
	date?: string;
	album?: string;
	width?: number;
	height?: number;
	order?: number;
};

type GalleryItem = {
	filename: string;
	src: string;
	thumbnail: string;
	title: string;
	description: string;
	date: string;
	year: string;
	album: string;
	width: number;
	height: number;
	order: number;
};

const galleryItems: GalleryItem[] = (galleryMetadata as GalleryMetadata[])
	.map((item) => ({
		filename: item.filename,
		src: `/gallery/${item.filename.split("/").map(encodeURIComponent).join("/")}`,
		thumbnail: `/gallery/${(item.thumbnail || item.filename).split("/").map(encodeURIComponent).join("/")}`,
		title: item.title?.trim() || "Untitled moment",
		description: item.description?.trim() || "",
		date: item.date?.trim() || "",
		year: item.date?.slice(0, 4) || "Unknown",
		album: item.album?.trim() || "Selected photos",
		width: item.width || 1600,
		height: item.height || 1200,
		order: Number.isFinite(item.order) ? Number(item.order) : 0,
	}))
	.sort(
		(a, b) =>
			b.date.localeCompare(a.date) ||
			a.order - b.order ||
			b.filename.localeCompare(a.filename, "en"),
	);

const groups = Object.entries(
	Object.groupBy(galleryItems, (item) => `${item.date}|${item.album}`),
)
	.map(([key, items]) => {
		const [date, album] = key.split("|");
		return { key, date, album, items: items || [] };
	})
	.sort(
		(a, b) =>
			b.date.localeCompare(a.date) || a.album.localeCompare(b.album, "en"),
	);
const years = [...new Set(galleryItems.map((item) => item.year))].sort((a, b) =>
	b.localeCompare(a),
);
const albums = [...new Set(galleryItems.map((item) => item.album))].sort(
	(a, b) => b.localeCompare(a, "en"),
);
const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

function formatDate(value: string) {
	if (!value) return "Date unknown";
	const date = new Date(`${value}T00:00:00`);
	return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
}
---

<MainGridLayout
	title="Gallery"
	description="Photographs and moments collected by Nguyễn Thanh Tùng."
	wide={true}
	immediateContent={true}
>
	<header class="gallery-header">
		<div class="gallery-title-row">
			<div class="gallery-heading-icon" aria-hidden="true">
				<Icon name="fa6-regular:images" />
			</div>
			<div>
				<p class="gallery-kicker">A visual journal</p>
				<h1>Gallery</h1>
				<p id="gallery-summary" aria-live="polite">{galleryItems.length} photos across {groups.length} collections</p>
			</div>
		</div>
	</header>

	{galleryItems.length > 0 ? (
		<>
			<section class="gallery-toolbar" aria-label="Filter the gallery">
				<label class="gallery-search-field">
					<span>Search</span>
					<span class="gallery-search">
						<Icon name="fa6-solid:magnifying-glass" aria-hidden="true" />
						<input id="gallery-search" type="search" placeholder="Title, description, or collection" autocomplete="off" />
					</span>
				</label>
				<label>
					<span>Year</span>
					<select id="gallery-year">
						<option value="">All</option>
						{years.map((year) => <option value={year}>{year}</option>)}
					</select>
				</label>
				<label>
					<span>Collection</span>
					<select id="gallery-album">
						<option value="">All</option>
						{albums.map((album) => <option value={album}>{album}</option>)}
					</select>
				</label>
				<button id="gallery-reset" type="button" class="gallery-reset" disabled>
					<Icon name="fa6-solid:filter-circle-xmark" aria-hidden="true" />
					Clear filters
				</button>
			</section>

			<div id="gallery-groups" class="gallery-groups">
				{groups.map((group) => (
					<section class="gallery-group" data-gallery-group>
						<header class="gallery-group-heading">
							<div>
								<h2>{group.album}</h2>
								<p>{formatDate(group.date)}</p>
							</div>
							<span data-gallery-group-count>{group.items.length} {group.items.length === 1 ? "photo" : "photos"}</span>
						</header>
						<div class="photo-gallery" aria-label={`${group.album} collection`}>
							{group.items.map((item, index) => (
								<figure
									class="gallery-card card-base interactive-card"
									data-gallery-item
									data-year={item.year}
									data-album={item.album.toLocaleLowerCase("en")}
									data-search={`${item.title} ${item.description} ${item.album}`.toLocaleLowerCase("en")}
								>
									<button
										type="button"
										data-pswp-src={item.src}
										data-pswp-width={item.width}
										data-pswp-height={item.height}
										data-pswp-title={item.title}
										data-pswp-description={item.description}
										aria-label={`View ${item.title}`}
										class="gallery-image-link"
									>
										<img
											src={item.thumbnail}
											alt={item.title}
											width={item.width}
											height={item.height}
											loading={group.key === groups[0]?.key && index < 2 ? "eager" : "lazy"}
											fetchpriority={group.key === groups[0]?.key && index === 0 ? "high" : "low"}
											decoding="async"
										/>
									</button>
									<figcaption class="gallery-caption">
										<h3>{item.title}</h3>
										{item.description && <p>{item.description}</p>}
									</figcaption>
								</figure>
							))}
						</div>
					</section>
				))}
			</div>
			<div id="gallery-empty" class="gallery-empty card-base" hidden>
				<Icon name="fa6-regular:image" aria-hidden="true" />
				<p>No matching photos found.</p>
			</div>
		</>
	) : (
		<div class="gallery-empty card-base">
			<Icon name="fa6-regular:image" aria-hidden="true" />
			<p>The gallery is empty.</p>
		</div>
	)}

	<script is:inline>
	(() => {
		const search = document.querySelector('#gallery-search');
		const year = document.querySelector('#gallery-year');
		const album = document.querySelector('#gallery-album');
		const reset = document.querySelector('#gallery-reset');
		const summary = document.querySelector('#gallery-summary');
		const empty = document.querySelector('#gallery-empty');
		if (!(search instanceof HTMLInputElement) || !(year instanceof HTMLSelectElement) || !(album instanceof HTMLSelectElement) || !(reset instanceof HTMLButtonElement)) return;
		if (search.dataset.bound === 'true') return;
		search.dataset.bound = 'true';

		const normalizeRestoredValue = (value) => value === 'null' || value === 'undefined' ? '' : value;
		search.value = normalizeRestoredValue(search.value);
		year.value = normalizeRestoredValue(year.value);
		album.value = normalizeRestoredValue(album.value);

		const apply = () => {
			const query = search.value.trim().toLocaleLowerCase('en');
			const selectedAlbum = album.value.trim().toLocaleLowerCase('en');
			let visibleItems = 0;
			let visibleGroups = 0;

			document.querySelectorAll('[data-gallery-group]').forEach((group) => {
				let groupItems = 0;
				group.querySelectorAll('[data-gallery-item]').forEach((item) => {
					const matchesSearch = !query || item.dataset.search?.includes(query) === true;
					const matchesYear = !year.value || item.dataset.year === year.value;
					const matchesAlbum = !selectedAlbum || item.dataset.album === selectedAlbum;
					const matches = matchesSearch && matchesYear && matchesAlbum;
					item.hidden = !matches;
					if (matches) groupItems += 1;
				});

				group.hidden = groupItems === 0;
				const count = group.querySelector('[data-gallery-group-count]');
				if (count) count.textContent = `${groupItems} ${groupItems === 1 ? 'photo' : 'photos'}`;
				if (groupItems > 0) visibleGroups += 1;
				visibleItems += groupItems;
			});

			reset.disabled = !query && !year.value && !selectedAlbum;
			if (summary) summary.textContent = `${visibleItems} ${visibleItems === 1 ? 'photo' : 'photos'} across ${visibleGroups} ${visibleGroups === 1 ? 'collection' : 'collections'}`;
			if (empty) empty.hidden = visibleItems !== 0;
		};

		search.addEventListener('input', apply);
		year.addEventListener('change', apply);
		album.addEventListener('change', apply);
		reset.addEventListener('click', () => {
			search.value = '';
			year.value = '';
			album.value = '';
			apply();
			search.focus();
		});

		apply();
	})();
	</script>
</MainGridLayout>

<style>
	.gallery-header {
		padding: 0.45rem 0.25rem 1.35rem;
		border-bottom: 1px solid var(--line-divider);
	}

	.gallery-title-row,
	.gallery-group-heading,
	.gallery-toolbar,
	.gallery-search {
		display: flex;
		align-items: center;
	}

	.gallery-title-row {
		gap: 0.9rem;
	}

	.gallery-heading-icon {
		display: grid;
		width: 3rem;
		height: 3rem;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 8px;
		border: 1px solid color-mix(in oklch, var(--primary), transparent 72%);
		background: var(--btn-regular-bg);
		color: var(--primary);
		font-size: 1.35rem;
	}

	.gallery-kicker,
	.gallery-header h1,
	.gallery-header p,
	.gallery-group-heading h2,
	.gallery-group-heading p,
	.gallery-caption h3,
	.gallery-caption p {
		margin: 0;
	}

	.gallery-kicker {
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 850;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.gallery-header h1 {
		color: var(--content-color);
		font-size: clamp(1.8rem, 4vw, 2.35rem);
		line-height: 1.15;
	}

	.gallery-header #gallery-summary {
		margin-top: 0.25rem;
		color: var(--meta-color);
		font-size: 0.86rem;
	}

	.gallery-toolbar {
		position: sticky;
		top: 4.75rem;
		z-index: 20;
		display: grid;
		grid-template-columns: minmax(13rem, 1.4fr) minmax(8rem, 0.6fr) minmax(10rem, 0.8fr) auto;
		align-items: end;
		gap: 0.65rem;
		margin: 1rem 0 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--card-border);
		border-radius: 8px;
		background: color-mix(in oklch, var(--float-panel-bg), transparent 2%);
		box-shadow: var(--card-shadow);
		backdrop-filter: blur(14px) saturate(1.05);
	}

	.gallery-toolbar > label {
		display: grid;
		min-width: 0;
		gap: 0.25rem;
		color: var(--meta-color);
		font-size: 0.7rem;
		font-weight: 800;
	}

	.gallery-search {
		gap: 0.55rem;
		padding: 0 0.75rem;
	}

	.gallery-search,
	.gallery-toolbar select,
	.gallery-reset {
		min-height: 2.75rem;
		border: 1px solid var(--card-border);
		border-radius: 7px;
		background: var(--btn-regular-bg);
		color: var(--content-color);
	}

	.gallery-search input {
		min-width: 0;
		width: 100%;
		border: 0;
		background: transparent;
		color: inherit;
		outline: none;
	}

	.gallery-toolbar select {
		width: 100%;
		padding: 0 0.65rem;
		font: inherit;
		font-weight: 750;
	}

	.gallery-reset {
		display: inline-flex;
		align-items: center;
		align-self: end;
		justify-content: center;
		gap: 0.4rem;
		padding: 0 0.8rem;
		font: inherit;
		font-weight: 800;
		cursor: pointer;
	}

	.gallery-reset:disabled {
		cursor: default;
		opacity: 0.48;
	}

	.gallery-groups {
		display: grid;
		gap: 2.5rem;
	}

	.gallery-group-heading {
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
		padding: 0 0.2rem 0.65rem;
		border-bottom: 1px solid var(--line-divider);
	}

	.gallery-group-heading h2 {
		color: var(--content-color);
		font-size: 1.15rem;
	}

	.gallery-group-heading p,
	.gallery-group-heading > span {
		color: var(--meta-color);
		font-size: 0.76rem;
	}

	.photo-gallery {
		column-count: 1;
		column-gap: 0.85rem;
	}

	.gallery-card {
		display: inline-block;
		width: 100%;
		margin: 0 0 0.85rem;
		break-inside: avoid;
		overflow: hidden;
		background: var(--card-bg-solid);
	}

	.gallery-image-link {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		overflow: hidden;
		cursor: zoom-in;
		background: color-mix(in oklch, var(--btn-regular-bg), var(--page-bg) 20%);
		text-align: left;
	}

	.gallery-image-link img {
		display: block;
		width: 100%;
		height: auto;
		transition: transform 220ms ease, filter 220ms ease;
	}

	.gallery-image-link:hover img {
		transform: scale(1.025);
		filter: saturate(1.04);
	}

	.gallery-caption {
		padding: 0.75rem 0.85rem 0.85rem;
		border-top: 1px solid var(--line-divider);
	}

	.gallery-caption h3 {
		color: var(--content-color);
		font-size: 0.88rem;
		line-height: 1.35;
	}

	.gallery-caption p {
		margin-top: 0.35rem;
		color: var(--meta-color);
		font-size: 0.78rem;
		line-height: 1.55;
	}

	.gallery-empty {
		display: grid;
		min-height: 13rem;
		place-content: center;
		justify-items: center;
		gap: 0.75rem;
		color: var(--meta-color);
	}

	.gallery-empty[hidden],
	.gallery-group[hidden],
	.gallery-card[hidden] {
		display: none;
	}

	.gallery-empty :global(svg) {
		color: var(--primary);
		font-size: 2.25rem;
	}

	@media (min-width: 640px) {
		.photo-gallery { column-count: 2; }
	}

	@media (min-width: 1024px) {
		.photo-gallery { column-count: 3; }
	}

	@media (min-width: 1440px) {
		.photo-gallery { column-count: 4; }
	}

	@media (max-width: 960px) {
		.gallery-header h1 { font-size: 1.7rem; }
		.gallery-toolbar {
			position: static;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
		}
		.gallery-search-field { grid-column: 1 / -1; }
	}

	@media (max-width: 640px) {
		.gallery-toolbar {
			grid-template-columns: 1fr;
			padding: 0.65rem;
		}
		.gallery-search-field { grid-column: auto; }
		.gallery-reset { width: 100%; }
		.gallery-group-heading { align-items: flex-end; }
		.gallery-groups { gap: 2rem; }
	}
</style>
