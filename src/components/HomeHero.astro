---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import heroImage from "../assets/images/home-engineering-workspace.png";
import type { HomepageData } from "../utils/homepage-data";

interface Props {
	data: HomepageData;
}

const { data } = Astro.props;
const updatedAt = data.lastUpdated ? new Date(data.lastUpdated) : undefined;
const updatedLabel =
	updatedAt && !Number.isNaN(updatedAt.getTime())
		? new Intl.DateTimeFormat("en-GB", {
				day: "2-digit",
				month: "short",
				year: "numeric",
				timeZone: "Asia/Ho_Chi_Minh",
			}).format(updatedAt)
		: "";
const liveTopic = data.liveTopics[0];
const registerEntries = [
	{
		label: "Engineering work",
		count: data.counts.projects,
		unit: "project records",
		scope: "Building services, process piping, and CAD/BIM workflows",
		href: "/portfolio/",
		icon: "material-symbols:architecture-rounded",
	},
	{
		label: "Journal",
		count: data.counts.journal,
		unit: "entries",
		scope: "Personal notes and working reflections",
		href: "/archive/",
		icon: "material-symbols:edit-note-rounded",
	},
	{
		label: "Second Brain",
		count: data.counts.liveVaults,
		unit: data.counts.liveVaults === 1 ? "public vault" : "public vaults",
		scope: liveTopic
			? `${liveTopic.title} linked research notes`
			: "Linked technical research notes",
		href: "/brain/",
		icon: "material-symbols:account-tree-outline-rounded",
	},
	{
		label: "Gallery",
		count: data.counts.gallery,
		unit: "photographs",
		scope: "Places, light, and ordinary moments",
		href: "/gallery/",
		icon: "material-symbols:photo-camera-outline-rounded",
	},
];
---

<section class="home-hero onload-animation" data-home-hero aria-labelledby="home-title">
	<div class="home-hero__media">
		<Image
			src={heroImage}
			alt="A quiet desk beside a sunlit window with a chair, a cup, and two plants"
			class="home-hero__image"
			widths={[480, 768, 1200, 1440]}
			sizes="(max-width: 760px) 100vw, 1280px"
			loading="eager"
			decoding="async"
			fetchpriority="high"
			quality={88}
		/>
		<div class="home-hero__shade" aria-hidden="true"></div>

		<div class="home-hero__content">
			<p class="home-hero__kicker">Building services / Process piping / Engineering notes</p>
			<h1 id="home-title"><span>Nguyễn</span>{" "}<span>Thanh Tùng</span></h1>
			<p class="home-hero__intro">
				Plumbing, fire protection, industrial piping, and CAD/BIM work, documented
				through projects and technical notes.
			</p>
			<div class="home-hero__actions">
				<a class="home-hero__primary" href="/portfolio/">
					Explore portfolio
					<Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
				</a>
				<a class="home-hero__secondary" href="/archive/">
					Read the journal
					<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
				</a>
			</div>
		</div>
	</div>

	<section
		class="work-register"
		data-document-register
		aria-labelledby="work-register-title"
	>
		<header>
			<div>
				<p>Knowledge index</p>
				<h2 id="work-register-title">Work &amp; Knowledge Register</h2>
			</div>
			{
				updatedLabel && updatedAt && (
					<p class="work-register__updated">
						<span>Last updated</span>
						<time datetime={data.lastUpdated}>{updatedLabel}</time>
					</p>
				)
			}
		</header>
		<dl>
			{
				registerEntries.map((entry) => (
					<div class="work-register__card">
						<span class="work-register__icon" aria-hidden="true">
							<Icon name={entry.icon} />
						</span>
						<dt>
							<a href={entry.href}>
								{entry.label}
								<Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
							</a>
						</dt>
						<dd class="work-register__count">
							<strong>{entry.count}</strong>
							<span>{entry.unit}</span>
						</dd>
						<dd class="work-register__scope">{entry.scope}</dd>
					</div>
				))
			}
		</dl>
	</section>
</section>

<style>
	.home-hero {
		display: grid;
		color: #fff;
	}

	.home-hero__media {
		position: relative;
		isolation: isolate;
		min-height: 38rem;
		overflow: hidden;
		border: 1px solid color-mix(in oklch, var(--primary), transparent 64%);
		border-radius: var(--radius-large) var(--radius-large) 0 0;
		background: #1c211f;
	}

	.home-hero__image,
	.home-hero__shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.home-hero__image {
		z-index: -2;
		object-fit: cover;
		object-position: center;
		filter: saturate(0.92) contrast(1.03);
	}

	.home-hero__shade {
		z-index: -1;
		background: rgb(5 9 8 / 38%);
	}

	.home-hero__content {
		position: absolute;
		right: 2rem;
		bottom: 2.2rem;
		left: 2rem;
		max-width: 42rem;
	}

	.home-hero__kicker,
	.work-register header > div > p,
	.work-register dt,
	.work-register__updated {
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: var(--home-font-meta);
		font-weight: 700;
		line-height: 1.35;
		text-transform: uppercase;
	}

	.home-hero__kicker {
		margin: 0 0 0.75rem;
		color: color-mix(in srgb, var(--primary), white 34%);
	}

	.home-hero h1 {
		margin: 0;
		font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
		font-size: var(--home-font-display);
		font-weight: 500;
		line-height: 0.96;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.home-hero h1 span {
		display: block;
		width: max-content;
		max-width: 100%;
		white-space: nowrap;
	}

	.home-hero__intro {
		max-width: 38rem;
		margin: 1.15rem 0 0;
		font-size: 16px;
		font-weight: 400;
		line-height: 1.65;
		color: rgb(255 255 255 / 82%);
	}

	.home-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1.1rem;
		align-items: center;
		margin-top: 1.5rem;
	}

	.home-hero__actions a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		font-size: var(--home-font-ui);
		font-weight: 700;
		color: #fff;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.home-hero__actions a:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 3px;
	}

	.home-hero__primary {
		padding: 0.7rem 1rem;
		border: 1px solid rgb(255 255 255 / 42%);
		border-radius: 0.35rem;
		background: rgb(7 17 16 / 82%);
	}

	.home-hero__primary:hover {
		border-color: #fff;
		background: #fff;
		color: #101716;
	}

	.home-hero__secondary {
		min-height: 2.75rem;
		color: rgb(255 255 255 / 82%) !important;
		text-decoration: underline;
		text-decoration-color: rgb(255 255 255 / 28%);
		text-underline-offset: 0.3rem;
	}

	.home-hero__secondary:hover {
		text-decoration-color: #fff;
	}

	.work-register {
		border: 1px solid var(--homepage-line-color, var(--line-color));
		border-top: 0;
		border-radius: 0 0 var(--radius-large) var(--radius-large);
		background: var(--homepage-register-bg, var(--card-bg-solid));
		color: var(--content-color);
	}

	.work-register header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 1.15rem 0.8rem;
		border-bottom: 1px solid var(--homepage-line-color, var(--line-color));
	}

	.work-register header > div > p,
	.work-register__updated {
		margin: 0;
		color: var(--homepage-meta-color, var(--meta-color));
	}

	.work-register h2 {
		margin: 0.18rem 0 0;
		font-size: 16px;
		line-height: 1.3;
	}

	.work-register__updated time {
		display: inline-flex;
		gap: 0.35rem;
		color: var(--content-color);
		white-space: nowrap;
	}

	.work-register dl {
		margin: 0;
	}

	.work-register dl div {
		display: grid;
		grid-template-columns: minmax(9.5rem, 0.7fr) minmax(16rem, 1.6fr) auto;
		gap: 1.25rem;
		align-items: center;
		min-width: 0;
		padding: 0.78rem 1.15rem;
	}

	.work-register dl div + div {
		border-top: 1px solid var(--homepage-line-color, var(--line-color));
	}

	.work-register dt {
		color: var(--homepage-meta-color, var(--meta-color));
	}

	.work-register dt a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--content-color);
	}

	.work-register dt svg {
		font-size: 0.9rem;
		color: var(--homepage-accent-text, var(--primary));
	}

	.work-register__scope {
		margin: 0;
		font-size: var(--home-font-small);
		line-height: 1.45;
		color: var(--homepage-meta-color, var(--meta-color));
	}

	.work-register__count {
		display: flex;
		gap: 0.42rem;
		align-items: baseline;
		justify-content: flex-end;
		margin: 0;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.work-register__count strong {
		font-size: 16px;
	}

	.work-register__count span {
		font-size: var(--home-font-meta);
		font-weight: 500;
		color: var(--homepage-meta-color, var(--meta-color));
	}

	@media (max-width: 800px) {
		.home-hero__media {
			min-height: 32rem;
		}

		.home-hero__content {
			right: 1.25rem;
			bottom: 1.5rem;
			left: 1.25rem;
		}

		.home-hero h1 {
			font-size: clamp(52px, 7vw, 64px);
		}

		.work-register dl div {
			grid-template-columns: minmax(8.5rem, 0.7fr) minmax(0, 1fr) auto;
			gap: 0.8rem;
		}
	}

	@media (max-width: 520px) {
		.home-hero__media {
			min-height: 23.75rem;
		}

		.home-hero__image {
			object-position: 52% center;
		}

		.home-hero__shade {
			background: rgb(5 9 8 / 48%);
		}

		.home-hero__content {
			right: 1rem;
			bottom: 0.85rem;
			left: 1rem;
		}

		.home-hero__kicker {
			margin-bottom: 0.35rem;
			font-size: var(--home-font-meta);
		}

		.home-hero h1 {
			font-size: var(--home-font-display);
		}

		.home-hero__intro {
			max-width: 32rem;
			margin-top: 0.55rem;
			font-size: var(--home-font-body);
			line-height: 1.5;
		}

		.home-hero__actions {
			margin-top: 0.7rem;
		}

		.home-hero__primary {
			min-height: 2.6rem;
		}

		.home-hero__secondary {
			min-height: 2.6rem;
		}

		.work-register header {
			position: relative;
			align-items: start;
			min-height: 3.25rem;
			padding: 0.7rem 4.15rem 0.62rem 0.8rem;
		}

		.work-register__updated {
			display: flex;
			flex-direction: column;
			max-width: 8rem;
			text-align: right;
		}

		.work-register__updated time {
			justify-content: flex-end;
		}

		.work-register dl {
			display: block;
		}

		.work-register dl div {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.2rem 0.8rem;
			padding: 0.7rem 0.8rem;
		}

		.work-register__scope {
			grid-column: 1 / -1;
			grid-row: 2;
			font-size: var(--home-font-meta);
		}

		.work-register__count {
			grid-column: 2;
			grid-row: 1;
		}

		.work-register__count strong {
			font-size: 15px;
		}

		.work-register__count span {
			font-size: var(--home-font-meta);
		}

		.home-hero__actions a {
			font-size: var(--home-font-small);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero__actions a {
			transition: none;
		}
	}
</style>

<style>
	.home-hero .home-hero__media {
		min-height: 37.5rem;
		border-color: rgb(255 255 255 / 12%);
		border-radius: var(--homepage-radius);
		box-shadow: var(--homepage-card-shadow);
	}

	.home-hero .home-hero__shade {
		background: rgb(5 9 8 / 47%);
	}

	.home-hero .home-hero__content {
		right: clamp(1.5rem, 4vw, 4rem);
		bottom: clamp(2rem, 5vw, 4rem);
		left: clamp(1.5rem, 4vw, 4rem);
		max-width: 44rem;
	}

	.home-hero .home-hero__kicker {
		color: #f0c28f;
	}

	.home-hero .home-hero__content h1 {
		font-family: var(--home-font-display-family);
		font-weight: 620;
		line-height: 0.98;
	}

	.home-hero .home-hero__intro {
		max-width: 40rem;
		font-size: var(--home-font-body);
		color: rgb(255 255 255 / 86%);
	}

	.home-hero .home-hero__actions {
		gap: 0.75rem;
		margin-top: 1.65rem;
	}

	.home-hero .home-hero__actions a {
		min-height: 2.85rem;
		padding: 0.7rem 1rem;
		border: 1px solid rgb(255 255 255 / 55%);
		border-radius: 0.25rem;
		text-decoration: none;
	}

	.home-hero .home-hero__primary {
		background: #fff;
		color: #162839;
	}

	.home-hero .home-hero__secondary {
		background: rgb(5 9 8 / 28%);
		color: #fff !important;
	}

	.home-hero .work-register {
		border: 0;
		border-radius: 0;
		background: transparent;
	}

	.home-hero .work-register header {
		padding: 0 0 1.25rem;
	}

	.home-hero .work-register h2 {
		margin-top: 0.3rem;
		font-size: var(--home-font-section-secondary);
		line-height: 1.15;
	}

	.home-hero .work-register__updated {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	@media (max-width: 520px) {
		.home-hero .home-hero__media {
			min-height: 30rem;
		}

		.home-hero .home-hero__content {
			right: 1rem;
			bottom: 1.15rem;
			left: 1rem;
		}

		.home-hero .home-hero__intro {
			margin-top: 0.7rem;
			font-size: 15px;
		}

		.home-hero .home-hero__actions {
			margin-top: 1rem;
		}

		.home-hero .work-register header {
			align-items: flex-start;
			min-height: 0;
			flex-direction: column;
			gap: 0.7rem;
			padding: 0 0 0.85rem;
		}

		.home-hero .work-register h2 {
			font-size: 25px;
		}

		.home-hero .work-register__updated {
			align-items: flex-start;
			max-width: none;
			text-align: left;
		}
	}
</style>

