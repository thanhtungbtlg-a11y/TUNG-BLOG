---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import heroImage from "../assets/images/home-hero-wallhaven.webp";
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

interface Props {
	totalPosts: number;
}

const { totalPosts } = Astro.props;

const quickLinks = [
	{
		label: "Kho bài",
		description: `${totalPosts} bài viết`,
		href: url("/archive/"),
		icon: "material-symbols:menu-book-outline-rounded",
		primary: true,
	},
	{
		label: "Giới thiệu",
		description: "Về mình",
		href: url("/about/"),
		icon: "material-symbols:person-outline-rounded",
	},
	{
		label: "Kho ảnh",
		description: "Ảnh và kỷ niệm",
		href: url("/gallery/"),
		icon: "material-symbols:photo-library-outline-rounded",
	},
	{
		label: "Second Brain",
		description: "Ghi chú mở",
		href: url("/brain/"),
		icon: "material-symbols:neurology-outline-rounded",
		native: true,
	},
];
---

<section class="home-hero onload-animation" aria-labelledby="home-hero-title">
	<Image
		src={heroImage}
		alt="Một căn phòng làm việc ấm áp với sách, máy tính cổ và ánh nắng chiếu qua cửa sổ"
		class="home-hero__image"
		widths={[640, 960, 1280, 1600, 1920]}
		sizes="(max-width: 768px) 100vw, 1280px"
		loading="eager"
		decoding="async"
		fetchpriority="high"
		quality={82}
	/>
	<div class="home-hero__shade"></div>
	<div class="home-hero__content">
		<p class="home-hero__eyebrow">Personal Journal</p>
		<h1 id="home-hero-title">{profileConfig.name}</h1>
		<p class="home-hero__summary">
			Một góc nhỏ để lưu lại bài viết, ảnh chụp và những ghi chú đang lớn
			dần theo thời gian.
		</p>
		<div class="home-hero__actions" aria-label="Điều hướng nhanh">
			{
				quickLinks.map((item) => (
					<a
						href={item.href}
						class:list={["home-hero__link", { "is-primary": item.primary }]}
						data-no-swup={item.native ? true : undefined}
						data-astro-reload={item.native ? true : undefined}
					>
						<Icon name={item.icon} />
						<span>
							<strong>{item.label}</strong>
							<small>{item.description}</small>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.home-hero {
		position: relative;
		min-height: min(42rem, calc(100svh - 7rem));
		overflow: hidden;
		border-radius: var(--radius-large);
		background: var(--card-bg);
		border: 1px solid color-mix(in oklch, var(--primary), transparent 70%);
		box-shadow: var(--card-shadow);
		isolation: isolate;
	}

	.home-hero::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background:
			linear-gradient(to top, rgb(0 0 0 / 0.58), transparent 52%),
			linear-gradient(90deg, rgb(0 0 0 / 0.66), transparent 58%),
			radial-gradient(circle at 82% 18%, rgb(255 233 180 / 0.16), transparent 34rem);
	}

	.home-hero__image {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transform: scale(1.01);
	}

	.home-hero__shade {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(to bottom, rgb(0 0 0 / 0.1), transparent 30%),
			linear-gradient(to right, rgb(14 10 8 / 0.1), transparent);
	}

	.home-hero__content {
		position: relative;
		z-index: 3;
		display: flex;
		min-height: inherit;
		max-width: 47rem;
		flex-direction: column;
		justify-content: end;
		padding: clamp(1.25rem, 4vw, 3.25rem);
		color: white;
		text-shadow: 0 2px 18px rgb(0 0 0 / 0.42);
	}

	.home-hero__eyebrow {
		margin: 0 0 0.8rem;
		color: color-mix(in oklch, var(--primary), white 44%);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.home-hero h1 {
		max-width: 12ch;
		margin: 0;
		color: white;
		font-size: clamp(3.2rem, 9vw, 6.9rem);
		font-weight: 900;
		line-height: 0.93;
		text-wrap: balance;
	}

	.home-hero__summary {
		max-width: 38rem;
		margin: 1.15rem 0 0;
		color: rgb(255 255 255 / 0.82);
		font-size: clamp(1rem, 2vw, 1.2rem);
		font-weight: 650;
		line-height: 1.75;
	}

	.home-hero__actions {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.7rem;
		margin-top: clamp(1.25rem, 3vw, 2rem);
	}

	.home-hero__link {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
		padding: 0.85rem;
		border: 1px solid rgb(255 255 255 / 0.18);
		border-radius: 0.75rem;
		background: rgb(0 0 0 / 0.24);
		color: white;
		backdrop-filter: blur(14px) saturate(1.08);
		-webkit-backdrop-filter: blur(14px) saturate(1.08);
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			background-color 180ms ease;
	}

	.home-hero__link:hover {
		transform: translateY(-2px);
		border-color: color-mix(in oklch, var(--primary), white 28%);
		background: rgb(255 255 255 / 0.13);
	}

	.home-hero__link.is-primary {
		background: color-mix(in oklch, var(--primary), rgb(0 0 0 / 0.22) 48%);
		border-color: color-mix(in oklch, var(--primary), white 34%);
	}

	.home-hero__link :global(svg) {
		flex: 0 0 auto;
		font-size: 1.35rem;
		color: color-mix(in oklch, var(--primary), white 46%);
	}

	.home-hero__link span {
		display: grid;
		min-width: 0;
		gap: 0.1rem;
	}

	.home-hero__link strong,
	.home-hero__link small {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.home-hero__link strong {
		color: white;
		font-size: 0.96rem;
	}

	.home-hero__link small {
		color: rgb(255 255 255 / 0.64);
		font-size: 0.78rem;
		font-weight: 700;
	}

	@media (max-width: 900px) {
		.home-hero {
			min-height: min(42rem, calc(100svh - 6rem));
		}

		.home-hero::after {
			background:
				linear-gradient(to top, rgb(0 0 0 / 0.72), transparent 58%),
				linear-gradient(90deg, rgb(0 0 0 / 0.32), transparent 72%);
		}

		.home-hero__actions {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.home-hero {
			min-height: 34rem;
			border-radius: 1.1rem;
		}

		.home-hero__content {
			padding: 1rem;
		}

		.home-hero h1 {
			font-size: 3.15rem;
		}

		.home-hero__summary {
			font-size: 0.96rem;
		}

		.home-hero__actions {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
