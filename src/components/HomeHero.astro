---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import heroImage from "../assets/images/home-engineering-workspace.png";
import type { HomepageData } from "../utils/homepage-data";

interface Props {
	data: HomepageData;
}

const { data } = Astro.props;
const updatedAt = data.lastUpdated ? new Date(data.lastUpdated) : undefined;
const updatedLabel =
	updatedAt && !Number.isNaN(updatedAt.getTime())
		? new Intl.DateTimeFormat("en-GB", {
				day: "2-digit",
				month: "short",
				year: "numeric",
				timeZone: "Asia/Ho_Chi_Minh",
			}).format(updatedAt)
		: "";
---

<section class="home-hero onload-animation" data-home-hero aria-labelledby="home-title">
	<div class="home-hero__media">
		<Image
			src={heroImage}
			alt="A quiet desk beside a sunlit window with a chair, a cup, and two plants"
			class="home-hero__image"
			widths={[480, 718]}
			sizes="(max-width: 760px) 100vw, 1200px"
			loading="eager"
			decoding="async"
			fetchpriority="high"
			quality={88}
		/>
		<div class="home-hero__shade" aria-hidden="true"></div>

		<div class="home-hero__content">
			<p class="home-hero__kicker">MEP / Piping / Knowledge systems</p>
			<h1 id="home-title">Nguyễn Thanh Tùng</h1>
			<p class="home-hero__intro">
				I design building services and industrial piping systems, then document
				what I learn through projects, notes, and photographs.
			</p>
			<div class="home-hero__actions">
				<a class="home-hero__primary" href="/portfolio/">
					View engineering work
					<Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
				</a>
				<a class="home-hero__secondary" href="/archive/">
					Read the journal
					<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
				</a>
			</div>
		</div>
	</div>

	<section
		class="work-register"
		data-document-register
		aria-labelledby="work-register-title"
	>
		<header>
			<div>
				<p>Index</p>
				<h2 id="work-register-title">Work &amp; Knowledge Register</h2>
			</div>
			{
				updatedLabel && updatedAt && (
					<p class="work-register__updated">
						Last updated <time datetime={data.lastUpdated}>{updatedLabel}</time>
					</p>
				)
			}
		</header>
		<dl>
			<div>
				<dt>Projects</dt>
				<dd>{data.counts.projects}<span> current records</span></dd>
			</div>
			<div>
				<dt>Journal</dt>
				<dd>{data.counts.journal}<span> entries</span></dd>
			</div>
			<div>
				<dt>Second Brain</dt>
				<dd>{data.counts.liveVaults}<span> live topic</span></dd>
			</div>
			<div>
				<dt>Gallery</dt>
				<dd>{data.counts.gallery}<span> photographs</span></dd>
			</div>
		</dl>
	</section>
</section>

<style>
	.home-hero {
		display: grid;
		color: #fff;
	}

	.home-hero__media {
		position: relative;
		isolation: isolate;
		min-height: 38rem;
		overflow: hidden;
		border: 1px solid color-mix(in oklch, var(--primary), transparent 64%);
		border-radius: var(--radius-large) var(--radius-large) 0 0;
		background: #1c211f;
	}

	.home-hero__image,
	.home-hero__shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.home-hero__image {
		z-index: -2;
		object-fit: cover;
		object-position: center;
		filter: saturate(0.92) contrast(1.03);
	}

	.home-hero__shade {
		z-index: -1;
		background: rgb(5 9 8 / 38%);
	}

	.home-hero__content {
		position: absolute;
		right: 2rem;
		bottom: 2.2rem;
		left: 2rem;
		max-width: 42rem;
	}

	.home-hero__kicker,
	.work-register header > div > p,
	.work-register dt,
	.work-register__updated {
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 0.68rem;
		font-weight: 700;
		line-height: 1.35;
		text-transform: uppercase;
	}

	.home-hero__kicker {
		margin: 0 0 0.75rem;
		color: color-mix(in srgb, var(--primary), white 34%);
	}

	.home-hero h1 {
		max-width: 10ch;
		margin: 0;
		font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
		font-size: 4.8rem;
		font-weight: 500;
		line-height: 0.96;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.home-hero__intro {
		max-width: 38rem;
		margin: 1.15rem 0 0;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.65;
		color: rgb(255 255 255 / 82%);
	}

	.home-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1.1rem;
		align-items: center;
		margin-top: 1.5rem;
	}

	.home-hero__actions a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		font-size: 0.86rem;
		font-weight: 700;
		color: #fff;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.home-hero__actions a:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 3px;
	}

	.home-hero__primary {
		padding: 0.7rem 1rem;
		border: 1px solid rgb(255 255 255 / 42%);
		border-radius: 0.35rem;
		background: rgb(7 17 16 / 82%);
	}

	.home-hero__primary:hover {
		border-color: #fff;
		background: #fff;
		color: #101716;
	}

	.home-hero__secondary {
		min-height: 2.75rem;
		text-decoration: underline;
		text-decoration-color: rgb(255 255 255 / 38%);
		text-underline-offset: 0.3rem;
	}

	.home-hero__secondary:hover {
		text-decoration-color: #fff;
	}

	.work-register {
		border: 1px solid color-mix(in oklch, var(--primary), transparent 64%);
		border-top: 0;
		border-radius: 0 0 var(--radius-large) var(--radius-large);
		background: var(--card-bg-solid);
		color: var(--content-color);
	}

	.work-register header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1rem 0.65rem;
		border-bottom: 1px solid var(--line-color);
	}

	.work-register header > div > p,
	.work-register__updated {
		margin: 0;
		color: var(--homepage-meta-color, var(--meta-color));
	}

	.work-register h2 {
		margin: 0.18rem 0 0;
		font-size: 0.96rem;
		line-height: 1.3;
	}

	.work-register__updated time {
		color: var(--content-color);
	}

	.work-register dl {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin: 0;
	}

	.work-register dl div {
		display: grid;
		align-content: center;
		gap: 0.22rem;
		min-width: 0;
		padding: 0.8rem 1rem;
	}

	.work-register dl div + div {
		border-left: 1px solid var(--line-color);
	}

	.work-register dt {
		color: var(--homepage-meta-color, var(--meta-color));
	}

	.work-register dd {
		margin: 0;
		font-size: 1rem;
		font-weight: 750;
		font-variant-numeric: tabular-nums;
	}

	.work-register dd span {
		font-size: 0.74rem;
		font-weight: 500;
		color: var(--homepage-meta-color, var(--meta-color));
	}

	@media (max-width: 800px) {
		.home-hero__media {
			min-height: 32rem;
		}

		.home-hero__content {
			right: 1.25rem;
			bottom: 1.5rem;
			left: 1.25rem;
		}

		.home-hero h1 {
			font-size: 3.45rem;
		}
	}

	@media (max-width: 520px) {
		.home-hero__media {
			min-height: 25.5rem;
		}

		.home-hero__image {
			object-position: 52% center;
		}

		.home-hero__shade {
			background: rgb(5 9 8 / 48%);
		}

		.home-hero__content {
			right: 1rem;
			bottom: 1rem;
			left: 1rem;
		}

		.home-hero__kicker {
			margin-bottom: 0.45rem;
			font-size: 0.6rem;
		}

		.home-hero h1 {
			max-width: 9ch;
			font-size: 2.7rem;
		}

		.home-hero__intro {
			margin-top: 0.7rem;
			font-size: 0.88rem;
			line-height: 1.5;
		}

		.home-hero__actions {
			margin-top: 0.85rem;
		}

		.home-hero__primary {
			min-height: 2.6rem;
		}

		.home-hero__secondary {
			min-height: 2.6rem;
		}

		.work-register header {
			align-items: start;
			padding-inline: 0.8rem;
		}

		.work-register__updated {
			max-width: 8rem;
			text-align: right;
		}

		.work-register dl {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.work-register dl div {
			padding: 0.62rem 0.8rem;
		}

		.work-register dl div:nth-child(3) {
			border-left: 0;
		}

		.work-register dl div:nth-child(n + 3) {
			border-top: 1px solid var(--line-color);
		}

		.work-register dd {
			display: flex;
			flex-direction: column;
			font-size: 0.9rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero__actions a {
			transition: none;
		}
	}
</style>
