---
import { Image } from "astro:assets";
import heroImage from "../assets/images/home-hero-wallhaven.webp";
---

<section class="home-hero onload-animation" aria-label="Home cover image">
	<Image
		src={heroImage}
		alt="A warm workspace with books, vintage computers, and sunlight through the window"
		class="home-hero__image"
		widths={[640, 960, 1280, 1600, 1920]}
		sizes="(max-width: 768px) 100vw, 1280px"
		loading="eager"
		decoding="async"
		fetchpriority="high"
		quality={84}
	/>
</section>

<style>
	.home-hero {
		position: relative;
		overflow: hidden;
		min-height: min(42rem, calc(100svh - 7rem));
		border: 1px solid color-mix(in oklch, var(--primary), transparent 72%);
		border-radius: var(--radius-large);
		background: var(--card-bg);
		box-shadow: var(--card-shadow);
	}

	.home-hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	@media (max-width: 900px) {
		.home-hero {
			min-height: min(36rem, calc(100svh - 6rem));
		}
	}

	@media (max-width: 520px) {
		.home-hero {
			min-height: 30rem;
			border-radius: 1.1rem;
		}
	}
</style>
