---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import heroImage from "../assets/images/home-engineering-workspace.png";
import type { HomepageData } from "../utils/homepage-data";

interface Props {
	data: HomepageData;
}

const { data } = Astro.props;
const buildDate = new Date();
const revision = `${String(buildDate.getMonth() + 1).padStart(2, "0")}.${String(buildDate.getFullYear()).slice(-2)}`;
---

<section class="home-hero onload-animation" data-home-hero aria-labelledby="home-title">
	<div class="home-hero__media">
		<Image
			src={heroImage}
			alt="A quiet desk beside a sunlit window with a chair, a cup, and two plants"
			class="home-hero__image"
			widths={[480, 718]}
			sizes="(max-width: 760px) 100vw, 1200px"
			loading="eager"
			decoding="async"
			fetchpriority="high"
			quality={88}
		/>
		<div class="home-hero__shade" aria-hidden="true"></div>

		<dl class="home-hero__metadata" aria-label="Homepage document metadata">
			<div>
				<dt>Document</dt>
				<dd>Home</dd>
			</div>
			<div>
				<dt>Revision</dt>
				<dd>{revision}</dd>
			</div>
			<div>
				<dt>Status</dt>
				<dd><span aria-hidden="true"></span>Active</dd>
			</div>
		</dl>

		<div class="home-hero__content">
			<p class="home-hero__kicker">MEP / Piping / Knowledge systems</p>
			<h1 id="home-title">Nguyễn Thanh Tùng</h1>
			<p class="home-hero__intro">
				I design building services and industrial piping systems, then
				document what I learn through projects, notes, and photographs.
			</p>
			<div class="home-hero__actions">
				<a class="home-hero__primary" href="/portfolio/">
					View engineering work
					<Icon name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
				</a>
				<a class="home-hero__secondary" href="/archive/">Read the journal</a>
			</div>
		</div>
	</div>

	<div class="document-register" data-document-register aria-label="Website document register">
		<p>
			<span>Register</span>
			<strong>Current record</strong>
		</p>
		<dl>
			<div>
				<dt>Journal</dt>
				<dd>{data.counts.journal}<span> entries</span></dd>
			</div>
			<div>
				<dt>Gallery</dt>
				<dd>{data.counts.gallery}<span> photographs</span></dd>
			</div>
			<div>
				<dt>Knowledge</dt>
				<dd>{data.counts.liveVaults}<span> live vault</span></dd>
			</div>
		</dl>
	</div>
</section>

<style>
	.home-hero {
		display: grid;
		gap: 0;
		color: #fff;
	}

	.home-hero__media {
		position: relative;
		isolation: isolate;
		min-height: 40rem;
		overflow: hidden;
		border: 1px solid color-mix(in oklch, var(--primary), transparent 64%);
		border-radius: var(--radius-large) var(--radius-large) 0 0;
		background: #1c211f;
		box-shadow: var(--card-shadow);
	}

	.home-hero__image,
	.home-hero__shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.home-hero__image {
		z-index: -2;
		object-fit: cover;
		object-position: center;
		filter: saturate(0.92) contrast(1.03);
	}

	.home-hero__shade {
		z-index: -1;
		background: rgb(5 9 8 / 38%);
	}

	.home-hero__metadata {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		display: grid;
		grid-template-columns: repeat(3, auto);
		margin: 0;
		border-top: 1px solid rgb(255 255 255 / 42%);
		border-bottom: 1px solid rgb(255 255 255 / 24%);
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 0.67rem;
		line-height: 1.25;
		text-transform: uppercase;
	}

	.home-hero__metadata div {
		display: grid;
		gap: 0.2rem;
		min-width: 6.3rem;
		padding: 0.55rem 0.7rem;
	}

	.home-hero__metadata div + div {
		border-left: 1px solid rgb(255 255 255 / 24%);
	}

	.home-hero__metadata dt {
		color: rgb(255 255 255 / 64%);
	}

	.home-hero__metadata dd {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
		font-weight: 700;
	}

	.home-hero__metadata dd span {
		width: 0.42rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary), transparent 72%);
	}

	.home-hero__content {
		position: absolute;
		right: 2rem;
		bottom: 2.2rem;
		left: 2rem;
		max-width: 42rem;
	}

	.home-hero__kicker {
		margin: 0 0 0.75rem;
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--primary), white 34%);
	}

	.home-hero h1 {
		max-width: 10ch;
		margin: 0;
		font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
		font-size: 4.8rem;
		font-weight: 500;
		line-height: 0.96;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.home-hero__intro {
		max-width: 38rem;
		margin: 1.25rem 0 0;
		font-size: 1.05rem;
		font-weight: 450;
		line-height: 1.65;
		color: rgb(255 255 255 / 84%);
	}

	.home-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.65rem;
	}

	.home-hero__actions a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		padding: 0.7rem 1rem;
		border: 1px solid rgb(255 255 255 / 34%);
		border-radius: var(--radius-large);
		font-size: 0.88rem;
		font-weight: 700;
		color: #fff;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.home-hero__actions a:focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 3px;
	}

	.home-hero__primary {
		background: rgb(7 17 16 / 82%);
	}

	.home-hero__secondary {
		background: rgb(255 255 255 / 8%);
	}

	.home-hero__actions a:hover {
		border-color: rgb(255 255 255 / 68%);
		background: #fff;
		color: #101716;
	}

	.document-register {
		display: grid;
		grid-template-columns: minmax(10rem, 0.75fr) minmax(0, 2fr);
		align-items: stretch;
		border: 1px solid color-mix(in oklch, var(--primary), transparent 64%);
		border-top: 0;
		border-radius: 0 0 var(--radius-large) var(--radius-large);
		background: var(--card-bg-solid);
		color: var(--content-color);
		box-shadow: var(--card-shadow);
	}

	.document-register > p {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.25rem;
		margin: 0;
		padding: 1rem 1.2rem;
		border-right: 1px solid var(--line-color);
	}

	.document-register > p span,
	.document-register dt {
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 0.66rem;
		font-weight: 700;
		line-height: 1.35;
		text-transform: uppercase;
		color: var(--meta-color);
	}

	.document-register > p strong {
		font-size: 0.92rem;
	}

	.document-register dl {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: 0;
	}

	.document-register dl div {
		display: grid;
		align-content: center;
		gap: 0.25rem;
		min-width: 0;
		padding: 0.9rem 1rem;
	}

	.document-register dl div + div {
		border-left: 1px solid var(--line-color);
	}

	.document-register dd {
		margin: 0;
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 1rem;
		font-weight: 750;
		font-variant-numeric: tabular-nums;
	}

	.document-register dd span {
		font-family: "Roboto Variable", Roboto, system-ui, sans-serif;
		font-size: 0.76rem;
		font-weight: 500;
		color: var(--meta-color);
	}

	@media (max-width: 800px) {
		.home-hero__media {
			min-height: 36rem;
		}

		.home-hero__metadata {
			top: 1rem;
			right: 1rem;
			left: 1rem;
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.home-hero__metadata div {
			min-width: 0;
		}

		.home-hero__content {
			right: 1.25rem;
			bottom: 1.5rem;
			left: 1.25rem;
		}

		.home-hero h1 {
			font-size: 3.45rem;
		}

		.document-register {
			grid-template-columns: 1fr;
		}

		.document-register > p {
			border-right: 0;
			border-bottom: 1px solid var(--line-color);
		}
	}

	@media (max-width: 520px) {
		.home-hero__media {
			min-height: 38rem;
		}

		.home-hero__image {
			object-position: 52% center;
		}

		.home-hero__shade {
			background: rgb(5 9 8 / 48%);
		}

		.home-hero__metadata {
			font-size: 0.6rem;
		}

		.home-hero__metadata div {
			padding: 0.5rem;
		}

		.home-hero h1 {
			max-width: 9ch;
			font-size: 2.85rem;
		}

		.home-hero__intro {
			font-size: 0.95rem;
		}

		.home-hero__actions {
			display: grid;
			grid-template-columns: 1fr;
		}

		.document-register dl div {
			padding: 0.75rem 0.55rem;
		}

		.document-register dd {
			display: flex;
			flex-direction: column;
			font-size: 0.9rem;
		}

		.document-register dd span {
			font-size: 0.66rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero__actions a {
			transition: none;
		}
	}
</style>
