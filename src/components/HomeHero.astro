		line-height: 1.45;
	}

	@media (max-width: 900px) {
		.work-register dl {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.home-hero {
			gap: 2.75rem;
		}

		.home-hero__media {
			min-height: 30rem;
		}

		.home-hero__content {
			right: 1rem;
