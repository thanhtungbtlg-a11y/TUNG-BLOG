			grid-template-columns: 1fr;
			gap: 0.75rem;
			margin-top: 0.9rem;
		}

		.work-register dl .work-register__card {
			min-height: 9.5rem;
			padding: 1rem;
		}

		.work-register__icon {
			margin-bottom: 0.65rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.work-register__card {
			transition: none;
		}
	}
</style>
