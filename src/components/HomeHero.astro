---
import { Image } from "astro:assets";
import { getSortedPostsList } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import heroImage from "../assets/images/home-hero-wallhaven.webp";
import { brainTopics } from "../data/brain-topics";
import galleryMetadata from "../data/gallery.json";
import galleryStatus from "../data/gallery-status.json";

const posts = await getSortedPostsList();
const latestPost = posts.reduce<(typeof posts)[number] | undefined>(
	(latest, post) => {
		if (!latest) return post;
		const postDate = post.data.updated ?? post.data.published;
		const latestDate = latest.data.updated ?? latest.data.published;
		return postDate.getTime() > latestDate.getTime() ? post : latest;
	},
	undefined,
);

type GalleryItem = (typeof galleryMetadata)[number];
const latestGalleryItem = galleryMetadata.reduce<GalleryItem | undefined>(
	(latest, item) => {
		if (!latest) return item;
		return new Date(item.date).getTime() > new Date(latest.date).getTime()
			? item
			: latest;
	},
	undefined,
);

const latestVault = brainTopics
	.filter((topic) => topic.status === "live" && topic.href && topic.lastUpdated)
	.sort(
		(a, b) =>
			new Date(b.lastUpdated ?? 0).getTime() -
			new Date(a.lastUpdated ?? 0).getTime(),
	)[0];

type HeroUpdate = {
	section: string;
	title: string;
	date: Date;
	href: string;
	icon: string;
	noSwup?: boolean;
};

const updates: HeroUpdate[] = [];
if (latestPost) {
	updates.push({
		section: "Journal",
		title: latestPost.data.title,
		date: latestPost.data.updated ?? latestPost.data.published,
		href: getPostUrlBySlug(latestPost.slug),
		icon: "material-symbols:article-outline-rounded",
	});
}
if (latestGalleryItem) {
	updates.push({
		section: "Gallery",
		title: latestGalleryItem.title,
		date: new Date(galleryStatus.lastUpdatedAt),
		href: "/gallery/",
		icon: "material-symbols:photo-library-outline-rounded",
	});
}
if (latestVault?.href && latestVault.lastUpdated) {
	updates.push({
		section: "Second Brain",
		title: latestVault.title,
		date: new Date(latestVault.lastUpdated),
		href: latestVault.href,
		icon: latestVault.icon,
		noSwup: true,
	});
}
updates.sort((a, b) => b.date.getTime() - a.date.getTime());

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "2-digit",
	month: "short",
	year: "numeric",
});
---

<section class="home-hero onload-animation" aria-label="Home cover image">
	<Image
		src={heroImage}
		alt="A warm workspace with books, vintage computers, and sunlight through the window"
		class="home-hero__image"
		widths={[640, 960, 1280, 1600, 1920]}
		sizes="(max-width: 768px) 100vw, 1280px"
		loading="eager"
		decoding="async"
		fetchpriority="high"
		quality={84}
	/>
	<div class="home-hero__updates" aria-label="Recent updates">
		<p>Recent updates</p>
		<div class="home-hero__update-list">
			{
				updates.map((update) => (
					<a
						class="home-hero__update"
						href={update.href}
						aria-label={`Open ${update.section}: ${update.title}`}
						data-no-swup={update.noSwup ? true : undefined}
					>
						<span class="home-hero__update-icon" aria-hidden="true">
							<Icon name={update.icon} />
						</span>
						<span class="home-hero__update-content">
							<small>
								{update.section}
								<time datetime={update.date.toISOString()}>
									{dateFormatter.format(update.date)}
								</time>
							</small>
							<strong>{update.title}</strong>
						</span>
						<Icon
							class="home-hero__update-arrow"
							name="material-symbols:arrow-outward-rounded"
						/>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.home-hero {
		position: relative;
		overflow: hidden;
		min-height: min(42rem, calc(100svh - 7rem));
		border: 1px solid color-mix(in oklch, var(--primary), transparent 72%);
		border-radius: var(--radius-large);
		background: var(--card-bg);
		box-shadow: var(--card-shadow);
	}

	.home-hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.home-hero__updates {
		position: absolute;
		right: 1.25rem;
		bottom: 0.6rem;
		left: 1.25rem;
		border: 1px solid rgb(255 255 255 / 18%);
		border-radius: calc(var(--radius-large) - 0.35rem);
		background: rgb(8 10 12 / 72%);
		color: #fff;
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}

	.home-hero__updates > p {
		margin: 0;
		padding: 0.65rem 1rem 0.55rem;
		border-bottom: 1px solid rgb(255 255 255 / 12%);
		font-size: 0.68rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(255 255 255 / 62%);
	}

	.home-hero__update-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.home-hero__update {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.7rem;
		min-width: 0;
		min-height: 4.25rem;
		padding: 0.65rem 0.8rem;
		color: #fff;
		transition: background-color 180ms ease;
	}

	.home-hero__update + .home-hero__update {
		border-left: 1px solid rgb(255 255 255 / 12%);
	}

	.home-hero__update:hover,
	.home-hero__update:focus-visible {
		background: rgb(255 255 255 / 9%);
	}

	.home-hero__update:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: -2px;
	}

	.home-hero__update-icon {
		display: grid;
		width: 2.25rem;
		aspect-ratio: 1;
		place-items: center;
		border-radius: 50%;
		background: rgb(255 255 255 / 10%);
		font-size: 1.15rem;
	}

	.home-hero__update-content {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.1rem;
	}

	.home-hero__update-content small {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.66rem;
		font-weight: 650;
		color: rgb(255 255 255 / 58%);
	}

	.home-hero__update-content time::before {
		margin-right: 0.45rem;
		content: "·";
	}

	.home-hero__update-content strong {
		overflow: hidden;
		font-size: 0.9rem;
		font-weight: 650;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.home-hero__update-arrow {
		font-size: 1.15rem;
		opacity: 0.7;
		transition: transform 180ms ease;
	}

	.home-hero__update:hover .home-hero__update-arrow {
		transform: translate(2px, -2px);
	}

	@media (max-width: 900px) {
		.home-hero {
			min-height: min(36rem, calc(100svh - 6rem));
		}
	}

	@media (max-width: 520px) {
		.home-hero {
			min-height: 30rem;
			border-radius: 1.1rem;
		}

		.home-hero__updates {
			right: 0.75rem;
			bottom: 0.45rem;
			left: 0.75rem;
		}

		.home-hero__updates > p {
			padding: 0.55rem 0.75rem 0.45rem;
		}

		.home-hero__update-list {
			display: flex;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}

		.home-hero__update-list::-webkit-scrollbar {
			display: none;
		}

		.home-hero__update {
			flex: 0 0 min(16rem, 84%);
			min-height: 4.1rem;
			scroll-snap-align: start;
		}

		.home-hero__update + .home-hero__update {
			border-left: 1px solid rgb(255 255 255 / 12%);
		}
	}
</style>
