---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base navbar-glass !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} aria-label={`Trang chủ - ${siteConfig.title}`} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-3 min-[360px]:px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <img
                    src={url('/favicon/favicon-dark-32.png')}
                    alt=""
                    width="32"
                    height="32"
                    class="h-8 w-8 rounded-lg object-cover mr-2 shadow-sm"
                />
                <span class="hidden min-[360px]:inline whitespace-nowrap">{siteConfig.title}</span>
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
						  rel={l.external ? "noopener noreferrer" : null}
                          data-no-swup={l.native ? true : undefined} data-astro-reload={l.native ? true : undefined}
                          class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex">
            <Search client:load></Search>
            {!siteConfig.themeColor.fixed && (
                    <div id="display-settings-wrapper" class="relative z-40">
						<button type="button" aria-label="Tùy chỉnh màu giao diện" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                            <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                        </button>
                        <DisplaySettings client:load></DisplaySettings>
                    </div>
            )}
            <LightDarkSwitch client:load></LightDarkSwitch>
			<button type="button" aria-label="Mở menu điều hướng" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
    </div>
</div>

<script is:inline>
(() => {
    if (window.__blogSearchBootstrapBound) return;
    window.__blogSearchBootstrapBound = true;

    const requestSearchOpen = () => {
        window.__pendingBlogSearchOpen = true;
        window.dispatchEvent(new CustomEvent("blog:open-search"));
    };

    document.addEventListener("keydown", (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
            event.preventDefault();
            requestSearchOpen();
        }
    }, true);

    document.addEventListener("click", (event) => {
        const target = event.target instanceof Element
            ? event.target.closest("#search-bar, #search-switch")
            : null;
        if (!target) return;
        event.preventDefault();
        requestSearchOpen();
    }, true);
})();
</script>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    let settingWrapper = document.getElementById("display-settings-wrapper");
    let settingPanel = document.getElementById("display-setting");
    if (settingBtn && settingWrapper && settingPanel) {
        settingBtn.onclick = function () {
            settingPanel.classList.toggle("float-panel-closed");
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();
</script>

<style is:global>
@media (hover: hover) and (pointer: fine) {
    #display-settings-wrapper:hover #display-setting {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }
}
</style>
