---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="navbar-load-cap absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "navbar-surface card-base navbar-glass !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} aria-label={`Home - ${siteConfig.title}`} class="navbar-brand btn-plain scale-animation rounded-lg h-[3.25rem] px-3 min-[360px]:px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <img
                    src={url('/favicon/favicon-dark-32.png')}
                    alt=""
                    width="32"
                    height="32"
                    class="navbar-brand-image h-8 w-8 rounded-lg object-cover mr-2 shadow-sm"
                />
                <span class="navbar-brand-title hidden min-[360px]:inline whitespace-nowrap">{siteConfig.title}</span>
                <span class="navbar-hero-mark hidden select-none" aria-hidden="true">✳︎</span>
            </div>
        </a>
        <div class="navbar-links hidden md:flex">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
						  rel={l.external ? "noopener noreferrer" : null}
                          data-no-swup={l.native ? true : undefined} data-astro-reload={l.native ? true : undefined}
                          data-nav-url={l.url}
                          class="navbar-link btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="navbar-actions flex">
            <Search client:load></Search>
            {!siteConfig.themeColor.fixed && (
                    <div id="display-settings-wrapper" class="relative z-40">
						<button type="button" aria-label="Customize theme colors" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                            <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                        </button>
                        <DisplaySettings client:load></DisplaySettings>
                    </div>
            )}
            <LightDarkSwitch client:load></LightDarkSwitch>
			<button type="button" aria-label="Open navigation menu" aria-expanded="false" name="Nav Menu" class="navbar-menu-button btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="navbar-menu-icon text-[1.25rem]"></Icon>
                <span class="navbar-menu-bars hidden" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
    </div>
</div>

<script is:inline>
(() => {
    if (window.__blogNavbarBootstrapBound) return;
    window.__blogNavbarBootstrapBound = true;

    const requestSearchOpen = () => {
        window.__pendingBlogSearchOpen = true;
        window.dispatchEvent(new CustomEvent("blog:open-search"));
    };

    const setMenuOpen = (open) => {
        const menuBtn = document.getElementById("nav-menu-switch");
        const menuPanel = document.getElementById("nav-menu-panel");
        if (!menuBtn || !menuPanel) return;

		menuPanel.classList.toggle("float-panel-closed", !open);
		menuBtn.classList.toggle("is-open", open);
		menuBtn.setAttribute("aria-expanded", String(open));
	};

    document.addEventListener("keydown", (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
            event.preventDefault();
            requestSearchOpen();
        }
        if (event.key === "Escape") setMenuOpen(false);
    }, true);

    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        const searchTarget = event.target.closest("#search-bar, #search-switch");
        if (searchTarget) {
            event.preventDefault();
            requestSearchOpen();
            return;
        }

        const menuButton = event.target.closest("#nav-menu-switch");
        if (menuButton) {
            event.preventDefault();
            const menuPanel = document.getElementById("nav-menu-panel");
            setMenuOpen(Boolean(menuPanel?.classList.contains("float-panel-closed")));
            return;
        }

        if (event.target.closest("#nav-menu-panel a")) {
            setMenuOpen(false);
            return;
        }

        const settingsButton = event.target.closest("#display-settings-switch");
        if (settingsButton) {
            event.preventDefault();
            document.getElementById("display-setting")?.classList.toggle("float-panel-closed");
        }
    }, true);
})();
</script>

<style is:global>
@media (hover: hover) and (pointer: fine) {
    #display-settings-wrapper:hover #display-setting {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }
}
</style>
