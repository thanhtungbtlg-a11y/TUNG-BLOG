---
import { Icon } from "astro-icon/components";
import { navBarConfig, profileConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;
const currentPath = Astro.url.pathname;
const isHomepage = currentPath === "/";
const emailUrl = profileConfig.links.find((link) => link.name === "Email")?.url;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

function isCurrentLink(link: NavBarLink) {
	if (link.external) return false;
	const linkPath = link.url.replace(/\/+$/, "") || "/";
	const pagePath = currentPath.replace(/\/+$/, "") || "/";
	return linkPath === "/"
		? pagePath === "/"
		: pagePath === linkPath || pagePath.startsWith(`${linkPath}/`);
}
---
<div id="navbar" class="z-50 onload-animation">
    <div class="navbar-load-cap absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "navbar-surface card-base navbar-glass !overflow-visible max-w-[var(--page-width)] h-[4.25rem] !rounded-t-none mx-auto flex items-center justify-between px-3 md:px-4"]}>
        <a href={url('/')} aria-label={`Home - ${isHomepage ? profileConfig.name : siteConfig.title}`} class="navbar-brand btn-plain scale-animation rounded-lg h-[3.25rem] px-3 min-[360px]:px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <img
                    src={url('/favicon/favicon-dark-32.png')}
                    alt=""
                    width="32"
                    height="32"
                    class="navbar-brand-image h-8 w-8 rounded-lg object-cover mr-2 shadow-sm"
                />
                <span
					class="navbar-brand-title hidden min-[360px]:inline whitespace-nowrap"
					data-home-label={profileConfig.name}
					data-default-label={siteConfig.title}
				>
					{isHomepage ? profileConfig.name : siteConfig.title}
				</span>
                <span class="navbar-hero-mark hidden select-none" aria-hidden="true">✳︎</span>
            </div>
        </a>
        <div class="navbar-links hidden md:flex">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
						  rel={l.external ? "noopener noreferrer" : null}
                          data-no-swup={l.native ? true : undefined} data-astro-reload={l.native ? true : undefined}
                          data-nav-url={l.url}
						  aria-current={isCurrentLink(l) ? "page" : undefined}
                          class:list={["navbar-link btn-plain rounded-lg h-11 font-bold px-4 active:scale-95", {"is-active": isCurrentLink(l)}]}
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="navbar-actions flex">
            <Search client:load></Search>
            {!siteConfig.themeColor.fixed && (
                    <div id="display-settings-wrapper" class="relative z-40">
						<button type="button" aria-label="Customize theme colors" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                            <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                        </button>
                        <DisplaySettings client:load></DisplaySettings>
                    </div>
            )}
            <LightDarkSwitch client:load></LightDarkSwitch>
			{emailUrl && (
				<a class="navbar-connect hidden lg:inline-flex" href={emailUrl} target="_blank" rel="noreferrer" hidden={!isHomepage}>
					Connect
				</a>
			)}
			<button type="button" aria-label="Open navigation menu" aria-expanded="false" name="Nav Menu" class="navbar-menu-button btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="navbar-menu-icon text-[1.25rem]"></Icon>
                <span class="navbar-menu-bars hidden" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
    </div>
</div>

<script is:inline>
(() => {
    if (window.__blogNavbarBootstrapBound) return;
    window.__blogNavbarBootstrapBound = true;

    const requestSearchOpen = () => {
        window.__pendingBlogSearchOpen = true;
        window.dispatchEvent(new CustomEvent("blog:open-search"));
    };

    const setMenuOpen = (open) => {
        const menuBtn = document.getElementById("nav-menu-switch");
        const menuPanel = document.getElementById("nav-menu-panel");
        if (!menuBtn || !menuPanel) return;

		menuPanel.classList.toggle("float-panel-closed", !open);
		menuBtn.classList.toggle("is-open", open);
		menuBtn.setAttribute("aria-expanded", String(open));
		menuPanel.setAttribute("aria-hidden", String(!open));
		menuPanel.toggleAttribute("inert", !open);
	};

	const normalizePath = (path) => path.replace(/\/+$/, "") || "/";

	const syncNavbarState = (pathname = window.location.pathname) => {
		const currentPath = normalizePath(pathname);
		const isHomepage = currentPath === "/";

		document.documentElement.classList.toggle("homepage-index-page", isHomepage);
		document.body?.classList.toggle("homepage-index-page", isHomepage);

		document.querySelectorAll("[data-nav-url]").forEach((link) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			const navUrl = link.dataset.navUrl;
			if (!navUrl) return;

			const target = new URL(navUrl, window.location.origin);
			const targetPath = normalizePath(target.pathname);
			const isCurrent = target.origin === window.location.origin && (
				targetPath === "/"
					? currentPath === "/"
					: currentPath === targetPath || currentPath.startsWith(`${targetPath}/`)
			);

			link.classList.toggle("is-active", isCurrent);
			if (isCurrent) link.setAttribute("aria-current", "page");
			else link.removeAttribute("aria-current");
		});

		const brand = document.querySelector(".navbar-brand");
		const brandTitle = document.querySelector(".navbar-brand-title");
		if (brandTitle instanceof HTMLElement) {
			const label = isHomepage
				? brandTitle.dataset.homeLabel
				: brandTitle.dataset.defaultLabel;
			if (label) {
				brandTitle.textContent = label;
				brand?.setAttribute("aria-label", `Home - ${label}`);
			}
		}

		const connect = document.querySelector(".navbar-connect");
		if (connect instanceof HTMLElement) {
			connect.toggleAttribute("hidden", !isHomepage);
		}
	};

	const scheduleNavbarStateSync = () => {
		window.requestAnimationFrame(() => syncNavbarState());
	};

	syncNavbarState();
	const bindSwupNavbarSync = () => {
		window.swup?.hooks?.on("visit:start", (visit) => {
			const target = new URL(visit.to.url, window.location.origin);
			syncNavbarState(target.pathname);
		});
		window.swup?.hooks?.on("page:view", () => syncNavbarState());
	};
	if (window.swup?.hooks) bindSwupNavbarSync();
	else document.addEventListener("swup:enable", bindSwupNavbarSync, { once: true });

	window.addEventListener("popstate", scheduleNavbarStateSync);

    document.addEventListener("keydown", (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
            event.preventDefault();
            requestSearchOpen();
        }
        if (event.key === "Escape") {
            const menuBtn = document.getElementById("nav-menu-switch");
            const menuPanel = document.getElementById("nav-menu-panel");
            if (menuBtn && menuPanel && !menuPanel.classList.contains("float-panel-closed")) {
                event.preventDefault();
                setMenuOpen(false);
                menuBtn.focus();
            }
        }
    }, true);

    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        const searchTarget = event.target.closest("#search-bar, #search-switch");
        if (searchTarget) {
            event.preventDefault();
            requestSearchOpen();
            return;
        }

        const menuButton = event.target.closest("#nav-menu-switch");
        if (menuButton) {
            event.preventDefault();
            const menuPanel = document.getElementById("nav-menu-panel");
            setMenuOpen(Boolean(menuPanel?.classList.contains("float-panel-closed")));
            return;
        }

		const navLink = event.target.closest("a[data-nav-url]");
		if (
			navLink instanceof HTMLAnchorElement &&
			event instanceof MouseEvent &&
			event.button === 0 &&
			!event.ctrlKey &&
			!event.metaKey &&
			!event.shiftKey &&
			!event.altKey &&
			navLink.target !== "_blank"
		) {
			const target = new URL(navLink.href, window.location.href);
			if (target.origin === window.location.origin) {
				syncNavbarState(target.pathname);
			}
		}

        if (event.target.closest("#nav-menu-panel a")) {
            setMenuOpen(false);
            return;
        }

        const settingsButton = event.target.closest("#display-settings-switch");
        if (settingsButton) {
            event.preventDefault();
            document.getElementById("display-setting")?.classList.toggle("float-panel-closed");
        }
    }, true);
})();
</script>

<style is:global>
.navbar-links {
	align-items: center;
	gap: 0.15rem;
}

.navbar-link {
	position: relative;
	font-size: 0.9rem;
}

.navbar-link::after {
	position: absolute;
	right: 0.8rem;
	bottom: 0.25rem;
	left: 0.8rem;
	height: 2px;
	border-radius: 2px;
	background: var(--primary);
	content: "";
	opacity: 0;
	transform: scaleX(0.45);
	transition: opacity 180ms ease, transform 180ms ease;
}

.navbar-link:hover::after,
.navbar-link.is-active::after {
	opacity: 1;
	transform: scaleX(1);
}

.navbar-link.is-active {
	color: var(--homepage-accent-text, var(--primary));
	background: color-mix(in oklch, var(--primary), transparent 91%);
}

.homepage-index-page .navbar-brand-title {
	color: var(--content-color);
	font-family: var(--home-font-display-family);
	font-size: 1.25rem;
	font-weight: 650;
}

.homepage-index-page .navbar-brand-image {
	display: none;
}

.homepage-index-page .search-trigger-label {
	color: var(--homepage-meta-color, var(--meta-color));
}

.homepage-index-page #navbar .navbar-surface {
	height: 4.5rem;
	border-right: 0;
	border-bottom: 1px solid var(--homepage-line-color);
	border-left: 0;
	border-radius: 0 !important;
	box-shadow: none;
	backdrop-filter: none;
	-webkit-backdrop-filter: none;
}

.homepage-index-page:not(.dark) #navbar .navbar-surface {
	background: color-mix(in srgb, var(--homepage-page-bg) 94%, white);
}

.homepage-index-page #navbar .navbar-link {
	border-radius: 0;
	font-size: var(--home-font-ui);
	font-weight: 650;
}

.homepage-index-page #navbar .navbar-link.is-active {
	color: var(--homepage-accent-text);
	background: transparent;
}

.homepage-index-page #navbar .navbar-link::after {
	right: 0.95rem;
	bottom: 0.15rem;
	left: 0.95rem;
	height: 1px;
	border-radius: 0;
	background: var(--homepage-accent-text);
}

.navbar-connect {
	min-height: 2.65rem;
	align-items: center;
	justify-content: center;
	margin-left: 0.4rem;
	padding: 0.6rem 1rem;
	border: 1px solid var(--content-color);
	border-radius: 0.25rem;
	background: var(--content-color);
	color: var(--homepage-page-bg, #fff);
	font-size: var(--home-font-ui, 14px);
	font-weight: 750;
	transition: background-color 180ms ease, color 180ms ease;
}

.navbar-connect[hidden] {
	display: none !important;
}

.navbar-connect:hover {
	background: transparent;
	color: var(--content-color);
}

@media (hover: hover) and (pointer: fine) {
    #display-settings-wrapper:hover #display-setting {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }
}

@media (max-width: 1100px) {
	.navbar-link {
		padding-inline: 0.7rem;
	}
}

@media (max-width: 860px) {
	#navbar .navbar-links {
		display: none;
	}

	#navbar .navbar-menu-button {
		display: flex !important;
	}
}
</style>
