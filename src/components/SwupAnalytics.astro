<template id="swup-analytics-script-anchor"></template>

<script>
	import { inject, pageview } from "@vercel/analytics";

	const scriptAnchor = document.getElementById("swup-analytics-script-anchor");
	const analyticsScript = scriptAnchor?.nextElementSibling;
	if (analyticsScript instanceof HTMLScriptElement) {
		analyticsScript.setAttribute("data-swup-ignore-script", "");
	}
	scriptAnchor?.remove();

	const analyticsWindow = window as typeof window & {
		__thanhTungVercelAnalyticsBound?: boolean;
	};

	const getBasePath = () => {
		try {
			return import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_BASEPATH as
				| string
				| undefined;
		} catch {
			return undefined;
		}
	};

	const getConfigString = () => {
		try {
			return import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_CLIENT_CONFIG as
				| string
				| undefined;
		} catch {
			return undefined;
		}
	};

	const trackPageView = () => {
		const path = `${window.location.pathname}${window.location.search}`;
		pageview({ route: window.location.pathname, path });
	};

	inject(
		{
			framework: "astro",
			disableAutoTrack: true,
			basePath: getBasePath(),
			beforeSend: window.webAnalyticsBeforeSend,
		},
		getConfigString(),
	);

	if (!analyticsWindow.__thanhTungVercelAnalyticsBound) {
		analyticsWindow.__thanhTungVercelAnalyticsBound = true;
		trackPageView();
		document.addEventListener("astro:page-load", trackPageView);
	}
</script>
