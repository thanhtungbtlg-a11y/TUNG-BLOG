---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
const isHomepage = Astro.url.pathname === "/";
---

<footer class="site-footer">
	<p>
		&copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}
		{isHomepage && <span class="footer-note">. Engineered with meticulous care.</span>}
	</p>
	<nav aria-label="Footer">
		<a href={url("rss.xml")}>RSS</a>
		<a href={url("sitemap-index.xml")}>Sitemap</a>
		<a href={url("/about/")}>About</a>
	</nav>
</footer>

<style>
	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 2.5rem 0 1.5rem;
		padding: 1.1rem 0.25rem 0;
		border-top: 1px solid var(--line-divider);
		color: var(--meta-color);
		font-size: var(--home-font-meta, 0.78rem);
	}

	:global(.homepage-index-page) .site-footer {
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		text-transform: uppercase;
		letter-spacing: 0;
	}

	.footer-note {
		text-transform: none;
	}

	.site-footer p {
		margin: 0;
	}

	.site-footer nav {
		display: flex;
		gap: 1rem;
	}

	.site-footer a {
		color: var(--meta-color);
		font-weight: 700;
		transition: color 180ms ease;
	}

	.site-footer a:hover {
		color: var(--primary);
	}

	@media (max-width: 520px) {
		.site-footer {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
