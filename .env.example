PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Vercel Supabase integration names are also supported:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Server-only variables for /admin. Never prefix the token with PUBLIC_.
GITHUB_TOKEN=github_pat_your_fine_grained_token
GITHUB_REPOSITORY=thanhtungbtlg-a11y/TUNG-BLOG
GITHUB_BRANCH=main

# Server-only comment submission and email notification variables.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_secret_key
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
COMMENT_RATE_LIMIT_SECRET=replace_with_a_long_random_string
# Optional: keeps anonymous visitor hashes stable if the Supabase secret key changes.
ANALYTICS_HASH_SECRET=replace_with_another_long_random_string
RESEND_API_KEY=re_your_resend_api_key
COMMENT_NOTIFICATION_TO=thanhtungbtlg@gmail.com
# After verifying thanhtung0209.com in Resend, use an address on the domain.
COMMENT_NOTIFICATION_FROM=Thanh Tung Blog <comments@thanhtung0209.com>
PUBLIC_SITE_URL=https://www.thanhtung0209.com

# Server-only protection for /portfolio. Never expose these with PUBLIC_ prefixes.
PORTFOLIO_PASSWORD=replace_with_the_portfolio_password
PORTFOLIO_ACCESS_SECRET=replace_with_a_long_random_string
