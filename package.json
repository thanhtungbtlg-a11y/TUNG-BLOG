	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.6",
		"@biomejs/biome": "2.2.5",
		"@types/hast": "^3.0.4",
		"@types/markdown-it": "^14.1.2",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.20.1",
		"@types/sanitize-html": "^2.16.0",
		"@types/turndown": "^5.0.6",
		"fast-xml-parser": "^5.8.0",
		"postcss-import": "^16.1.1",
		"postcss-nesting": "^13.0.2",
		"turndown": "^7.2.4"
	},
	"packageManager": "pnpm@9.14.4"
