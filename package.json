{
	"name": "thanhtung0209-blog",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "node scripts/generate-music-manifest.mjs && astro dev",
		"start": "astro dev",
		"check": "astro check",
		"build:site": "node scripts/generate-music-manifest.mjs && astro build",
		"build": "pnpm build:site && node scripts/build-brain.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "tsc --noEmit",
		"test": "node --test \"tests/*.test.ts\"",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:a11y": "playwright test --grep accessibility",
		"test:visual": "playwright test --config=playwright.visual.config.ts",
		"test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
		"test:lighthouse": "lhci autorun",
		"check:site": "node scripts/check-site-health.mjs",
		"new-post": "node scripts/new-post.js",
		"new-photo": "node scripts/new-gallery-photo.mjs",
		"import-gallery": "node scripts/import-gallery-folder.mjs",
		"optimize-post-images": "node scripts/optimize-post-images.mjs",
		"format": "biome format --write ./src ./api ./scripts ./tests",
		"lint": "biome check ./src ./api ./scripts ./tests",
		"lint:fix": "biome check --write ./src ./api ./scripts ./tests",
		"preinstall": "npx only-allow pnpm",
		"music": "node scripts/generate-music-manifest.mjs",
		"brain:sync": "node scripts/sync-brain-vault.mjs",
		"brain:build": "node scripts/build-brain.mjs",
		"brain:dev": "node scripts/sync-brain-vault.mjs && node scripts/build-brain.mjs --serve",
		"import-wordpress": "node scripts/import-wordpress.mjs"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.6.0",
		"@astrojs/svelte": "7.2.5",
		"@astrojs/tailwind": "^6.0.2",
		"@expressive-code/core": "^0.41.4",
		"@expressive-code/plugin-collapsible-sections": "^0.41.4",
		"@expressive-code/plugin-line-numbers": "^0.41.4",
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/roboto": "^5.2.10",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.90",
		"@iconify/svelte": "^4.2.0",
		"@supabase/supabase-js": "^2.108.1",
		"@swup/astro": "^1.7.0",
		"@tailwindcss/typography": "^0.5.20",
		"@vercel/analytics": "^2.0.1",
		"@vercel/functions": "3.7.2",
		"astro": "5.18.2",
		"astro-expressive-code": "^0.41.4",
		"astro-icon": "^1.1.5",
		"fuse.js": "^7.4.2",
		"gray-matter": "^4.0.3",
		"hastscript": "^9.0.1",
		"katex": "^0.16.27",
		"markdown-it": "^14.1.0",
		"mdast-util-to-string": "^4.0.0",
		"photoswipe": "^5.4.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^3.0.1",
		"remark-directive-rehype": "^0.4.2",
		"remark-github-admonitions-to-directives": "^1.0.5",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.17.7",
		"sharp": "^0.34.5",
		"stylus": "^0.64.0",
		"svelte": "5.56.4",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.11",
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "2.2.5",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "^1.62.1",
		"@types/hast": "^3.0.5",
		"@types/markdown-it": "^14.1.2",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.20.1",
		"@types/sanitize-html": "^2.16.1",
		"@types/turndown": "^5.0.6",
		"fast-xml-parser": "^5.8.0",
		"postcss-import": "^16.1.1",
		"postcss-nesting": "^13.0.2",
		"turndown": "^7.2.4"
	},
	"packageManager": "pnpm@9.14.4"
}
